#!/usr/bin/env node
// Schedules, records and lands a batch of tickets, each through `/10x:work` and `/10x:close` in its own
// `claude -p` worker; /10x:batch relays the workers' turns and the user's answers.
//
//   10x-batch init [--auto] <ticket>... [--search "<query>"]
//   10x-batch run <id> plan|reply|implement|close
//   10x-batch status
//   10x-batch drop <id>
//   10x-batch approve <id>
//   10x-batch accept-green <id> <file> "<reason>"
//   10x-batch loop
//
// With TENX_BATCH set (every worker has it), init, run, drop, approve, accept-green and loop refuse before reading
// anything, so a worker cannot drive its own batch; status still runs.
//
// The records a decision is made from live in the state dir S, out of every worker's reach: S is
// <base>/10x/<first 16 hex of the sha256 of the realpath of the git common dir>, canonical, where <base> is
// $XDG_STATE_HOME when it is absolute, else ~/.local/state. S/batch/ holds `tickets` (one id per line, board order),
// `mode` (`auto` or `default`; anything else, or no file, is default), `versions` and `versions.closed`, and per ticket
// <id>/: runs.tsv (`n kind session session_kind start end exit pid`, times in epoch ms, end and exit empty while a run
// is open), `auto-approved` (the plan hash `loop` approved), `dropped` and `accepted-green.md` (the GREEN test files the
// user accepted). S, S/batch and S/batch/<id> are made 0700, and a symlink at any of them is refused. init, run, drop,
// approve, accept-green and loop first refuse an S equal to or inside the
// main checkout, a worktree, a path the worker sandbox may write, or a sandbox.filesystem.allowWrite of the project's
// or the user's .claude/settings.json or settings.local.json, or of the same two files in CLAUDE_CONFIG_DIR, when set,
// resolved against the main checkout (`state dir <S> is inside <path>`).
// The rest lives in the main checkout's .10x/_batch/: `board.md`, and per ticket <id>/: <nn>-<kind>.jsonl (the
// worker's stream-json), <nn>-denials.tsv (`<tool>\t<command, file or tool>`), turn.md (every assistant text of the
// latest run), reply.md (the next reply, moved to <nn>-reply.md once sent), <nn>-landed (the base and sha a close run
// left), <nn>-fallback (the mode a run started in when auto mode was unavailable), <nn>-sandbox (`unavailable` when
// the worker's sandbox was) and run.err (the stderr of loop's latest run). A phase is never stored: every command
// derives it from these files and .10x/<id>/.
//
// `init` resolves every argument before writing anything (`<n>`, `#<n>`, `gh-<n>`, an issue URL of origin's repo,
// `--search` once, or an id with .10x/<id>/ticket.md) and exits 2 naming each one that resolves to no ticket, and each
// gh-<n> whose author is not the `gh` login (`not your issue: gh-<n> (author <login>)`): a stranger's issue could
// steer a worker. `--auto` records the auto mode. An
// argument that resolves to no ticket, is a valid id and not a number is tried as a version of .10x/roadmap.md
// (scripts/roadmap.js): it resolves to the ticket ids of its row, each resolved as an argument, except an id with
// .10x/<id>/landed (written by `10x-worktree rm` once the branch landed), whatever its ticket source, and a gh-<n> whose
// issue is closed, which are left out; a row with no id exits 2. The version names go to `versions`, the landed and
// closed ids to `versions.closed`, less any id also named directly, which is batched again. A previous batch (one with
// S/batch/tickets) is refused while .10x/_batch/ exists and a ticket of it is unsettled; else .10x/_batch/ and S/batch/
// are archived to .10x/_batch.<YYYYMMDD-HHMMSS>/ and S/batch.<YYYYMMDD-HHMMSS>/, one stamp free in both. A
// .10x/_batch/tickets with no S/batch/tickets is a batch from before S, refused. The approval records of the tickets it
// takes in are deleted.
// `run` starts one worker turn and waits for it: ${TENX_BATCH_CLAUDE:-claude} -p … --output-format stream-json
// --verbose --permission-mode auto, a plan session's worker with TENX_BATCH_PLAN_DIR set to .10x/<id> for
// hooks/plan-boundary.js, a new --session-id for plan, implement and close, --resume of the ticket's latest
// session for reply, the prompt after `--`. When the worker's stream-json init event reports another permission mode
// (auto mode unavailable), it is stopped and the turn runs again as a new run in the mode used before auto mode: a plan
// session in default with Edit(.10x/<id>/**) allowed, implement and close in acceptEdits. Every run gets
// --disallowedTools for the commands hooks/grant.js always asks for (10x-land issue/comment/advisory, 10x-batch
// approve/init/accept-green, 10x-security set/remove/ticket), Edit of S and of the settings files (the main
// checkout's .claude/, ~/.claude/ and, when set, $CLAUDE_CONFIG_DIR's settings.json and settings.local.json), and Edit
// of what
// a process outside the sandbox runs (writeDeny(): the git common dir, every <worktree dir>/*/.git, the main checkout's
// .envrc, the zsh files of $ZDOTDIR and $HOME/.zshenv, the bash, git, ssh and login-agent files of $HOME, the plugin
// root, each as a real path and, when a symlink, its target too), and --settings right
// after --verbose: Claude Code's sandbox, required (a worker whose sandbox is unavailable writes <nn>-sandbox and its
// ticket fails with `sandbox unavailable`, never run again), its writes kept to the temp dir, the package-manager and
// toolchain caches, /dev/stdout and /dev/fd. It refuses a plan, implement or close that `status` does not list, a reply
// to a planning session while a plan-session run that started before the ticket's latest run ended is open, and a
// reply whose first line starts with `/`, and a gh-<n> ticket whose issue is no longer the user's. Every worker gets
// TENX_BATCH=1. SIGTERM and SIGINT are forwarded to the worker. It prints
// `phase: <phase>` and `board: <path>`, exit 0 once the worker ran, whatever its exit code.
// `status` writes and prints the board, then the actions allowed now: `plan <id>`, `implement <id>`, `close <id>`,
// `answer <id>[ approvable]`, and `done` when every ticket is settled. `status` and `init` also set the State of each
// recorded version whose ids are all landed or closed to `Done <YYYY-MM-DD>` (local date) in .10x/roadmap.md,
// changing nothing else, once, and print `roadmap: <version> Done <date>` when they do.
// `approve` records the user's approval of a draft plan that passes 10x-plan-check: the sha256 of plan.md with its
// Status line blanked, in S/<id>.approved, printing the plan's path and short hash, out of reach of every worker: its
// Bash runs in the sandbox, which cannot write S, and its Edit and Write tools are denied S. A plan session's ticket is
// `approved`
// only when plan.md says so and that record matches it. It then writes the approve reply to reply.md.
// `accept-green` records, on the user's go only, that a test file staying GREEN in 10x-red-proof is accepted: it
// appends `## Accepted <n>` with the file, its blob at the ticket worktree's HEAD and the reason (newlines flattened) to
// S/batch/<id>/accepted-green.md and prints `accepted: <id> <file> blob <12 hex>`. While the ticket is in the batch,
// red-proof and the review packet read only that record, never .10x/<id>/accepted-green.md, which a worker could
// write. It refuses a ticket not in the batch or dropped, one without a worktree, an empty reason, and a file that is
// not a test file (redProof.tests, else red-proof's *.test|spec.* pattern) the branch adds or modifies against the
// merge base with the base ref. No skill grants it, so each acceptance asks; it writes no reply.md.
// `loop` drives the batch until a human is needed: each pass writes the board, starts every plan, implement and close
// action and every reply whose reply.md exists as a detached `run`, and in auto mode approves a draft that passes
// 10x-plan-check (writing `auto-approved`) or sends a planning question FIXED_REPLY (at most 3 times), unless
// .10x/<id>/comment.md or product-questions.md exists. It waits for one of its runs or 10 seconds between passes, and
// once nothing runs prints one line, {"items":[…]}: per ticket `failed`, `answer`, `approve` or `denied` with its
// evidence, or [{"need":"done"}] when every ticket is settled.
// `drop` sends SIGTERM to the ticket's open worker (a process whose command line holds the run's session), marks it
// dropped and rewrites the board.
//
// A permission denial does not decide a phase: a run that exits 0 is judged by the ticket's files, and its denials are
// added to the evidence and listed under `## Needs the human`. A ticket waiting on its implement session shows the
// `asked` texts of evidence.md; each approved entry of .10x/<id>/relock.md adds `relocked: <reason>` to the evidence
// and, until the ticket lands, under `## Needs the human`. A ticket whose latest run has a <nn>-fallback file adds
// `auto mode unavailable: ran in <mode>` to its evidence.
//
// Config (.claude/10x.json): `close`, `worktreeDir`, `batch.parallel` (implement runs at once, an integer ≥ 1,
// default 1). Refusals print `10x-batch: <why>` and exit 2.

const { execFileSync, spawn, spawnSync } = require('node:child_process')
const { createHash, randomUUID } = require('node:crypto')
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const md = require(path.join(__dirname, '..', 'scripts', 'md-check.js'))
const roadmap = require(path.join(__dirname, '..', 'scripts', 'roadmap.js'))

const ID = /^[A-Za-z0-9][A-Za-z0-9._-]*$/
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const KINDS = ['plan', 'reply', 'implement', 'close']
const HEADER = ['n', 'kind', 'session', 'session_kind', 'start', 'end', 'exit', 'pid']
const RUNNING = { plan: 'planning', implement: 'implementing', close: 'closing' }
const SETTLED = new Set(['landed', 'pr-open', 'failed', 'held', 'dropped'])
const USAGE =
  'usage: 10x-batch init [--auto] <ticket>... [--search "<query>"] | run <id> plan|reply|implement|close | status | drop <id> | approve <id> | accept-green <id> <file> "<reason>" | loop'
const APPROVE_REPLY = 'Approved. Set `Status: approved` in plan.md and stop; the implementation runs in a new session.\n'
const FIXED_REPLY =
  "Auto mode: no human answers this batch's questions. A question the ticket itself asks, and any product question — what the user gets, the outcome of an edge case, what counts as done — is a product question. If any question you asked is a product question, answer none of them: write their numbers, one per line, to `product-questions.md` in this ticket's `.10x/<id>/` directory, and stop. Otherwise answer every question with your own recommendation, record each in plan.md under `## Auto decisions`, one line per question (its number, the choice and why), and go on.\n"
const FIXED_MAX = 3
const POLL_MS = 10000

const die = (msg) => {
  process.stderr.write(`10x-batch: ${msg}\n`)
  process.exit(2)
}

if (process.env.TENX_BATCH && ['init', 'run', 'drop', 'approve', 'accept-green', 'loop'].includes(process.argv[2])) die('refused inside a batch worker')

let common
try {
  common = execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-common-dir'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()
} catch {
  die('not in a git repository')
}
const ROOT = path.dirname(common)
const config = readConfig()
const CLOSE = config.close == null ? 'pr' : String(config.close)
const WT_DIR = path.join(ROOT, typeof config.worktreeDir === 'string' && config.worktreeDir ? config.worktreeDir : '.worktrees')
const PARALLEL = parallel()
const TENX_DIR = path.join(ROOT, '.10x')
const BATCH = path.join(TENX_DIR, '_batch')
const HOME = os.homedir()
const xdg = process.env.XDG_STATE_HOME
const S = canonical(path.join(xdg && path.isAbsolute(xdg) ? xdg : path.join(HOME, '.local', 'state'), '10x', createHash('sha256').update(fs.realpathSync(common)).digest('hex').slice(0, 16)))
const SB = path.join(S, 'batch')
const TICKETS = path.join(SB, 'tickets')
const MODE = path.join(SB, 'mode')
const BOARD = path.join(BATCH, 'board.md')
const VERSIONS = path.join(SB, 'versions')
const CLOSED = path.join(SB, 'versions.closed')
const ROADMAP = path.join(TENX_DIR, 'roadmap.md')
// What a worker's sandboxed Bash may write besides the working directory, and the settings that could widen it.
const ALLOW_WRITE = [os.tmpdir(), ...['.npm', 'Library/pnpm', 'Library/Caches', '.cache', 'Library/Developer'].map((x) => path.join(HOME, x)), '/dev/stdout', '/dev/fd']
// With CLAUDE_CONFIG_DIR set (empty included), Claude Code reads user settings there, resolved against its cwd: a
// worker's is ROOT.
const configDir = process.env.CLAUDE_CONFIG_DIR
const SETTINGS_FILES = [path.join(ROOT, '.claude'), path.join(HOME, '.claude'), ...(configDir === undefined ? [] : [path.resolve(ROOT, configDir)])]
  .flatMap((d) => [path.join(d, 'settings.json'), path.join(d, 'settings.local.json')])
// What a process outside the sandbox later runs — git, a shell, a login agent, this plugin's scripts — which a worker's
// Write and Edit tools must not reach: real paths, plus the real path of any that is a symlink. zsh reads $HOME/.zshenv
// before ZDOTDIR is set; a relative ZDOTDIR or XDG_CONFIG_HOME is ignored. `<worktree dir>/*/.git` covers the worktrees
// a run creates after it starts. A path through a dangling symlink, at it or at an ancestor, is denied with the path
// the link names, as far as it resolves.
// Built by run() only.
function writeDeny() {
  const real = (p) => {
    for (let hops = 0; hops < 40; hops++) {
      try {
        return canonical(p)
      } catch {
        // The deepest existing ancestor (or p itself) is a dangling link: follow it, keep the rest of the path.
        const rest = []
        let cur = p
        while (!fs.lstatSync(cur, { throwIfNoEntry: false })) {
          rest.unshift(path.basename(cur))
          cur = path.dirname(cur)
        }
        if (!fs.lstatSync(cur).isSymbolicLink()) return p
        p = path.join(path.resolve(path.dirname(cur), fs.readlinkSync(cur)), ...rest)
      }
    }
    return p
  }
  const abs = (v) => (v && path.isAbsolute(v) ? real(v) : null)
  const home = canonical(HOME)
  const zdot = abs(process.env.ZDOTDIR) || home
  const xdgConfig = abs(process.env.XDG_CONFIG_HOME)
  const files = [
    path.join(canonical(ROOT), '.envrc'),
    ...['.zshrc', '.zshenv', '.zprofile', '.zlogin'].map((f) => path.join(zdot, f)),
    ...['.zshenv', '.bashrc', '.bash_profile', '.bash_login', '.profile', '.gitconfig', '.ssh/config'].map((f) => path.join(home, f)),
  ]
  const dirs = [
    fs.realpathSync(common),
    path.join(home, '.config', 'git'),
    ...(xdgConfig ? [path.join(xdgConfig, 'git')] : []),
    ...['Library/LaunchAgents', '.config/systemd/user', '.config/autostart'].map((d) => path.join(home, d)),
    canonical(path.join(__dirname, '..')),
  ]
  return [
    ...new Set([
      ...files.flatMap((f) => [f, real(f)]),
      ...dirs.flatMap((d) => [d, real(d)]).map((d) => `${d}/**`),
      `${canonical(WT_DIR)}/*/.git`,
    ]),
  ]
}
const SANDBOX = JSON.stringify({
  sandbox: {
    enabled: true,
    allowUnsandboxedCommands: false,
    failIfUnavailable: true,
    enableWeakerNetworkIsolation: true,
    filesystem: { allowWrite: ALLOW_WRITE },
    network: { allowedDomains: ['*'], allowLocalBinding: true },
  },
})
if (['init', 'run', 'drop', 'approve', 'accept-green', 'loop'].includes(process.argv[2])) checkStateDir()
for (const p of [TENX_DIR, BATCH, S, SB]) if (fs.lstatSync(p, { throwIfNoEntry: false })?.isSymbolicLink()) die(`${p} is a symlink`)

const tdir = (id) => path.join(TENX_DIR, id)
const approval = (id) => path.join(S, `${id}.approved`)
// The comment authors of a gh-<n> ticket.md as init saw it, kept beside the approval records, out of a worker's reach.
const commenters = (id) => path.join(S, `${id}.commenters`)
const mkd = (d) => fs.mkdirSync(d, { recursive: true, mode: 0o700 })
// What the user approved: plan.md with its Status line blanked, so the worker's `Status: approved` keeps the hash.
const planHash = (text) => createHash('sha256').update(text.replace(/^Status:.*$/m, 'Status:')).digest('hex')
const bdir = (id) => {
  const d = path.join(BATCH, id)
  if (fs.lstatSync(d, { throwIfNoEntry: false })?.isSymbolicLink()) die(`${d} is a symlink`)
  return d
}
const sdir = (id) => {
  const d = path.join(SB, id)
  if (fs.lstatSync(d, { throwIfNoEntry: false })?.isSymbolicLink()) die(`${d} is a symlink`)
  return d
}
const rel = (p) => path.relative(ROOT, p)
const pad = (n) => String(n).padStart(2, '0')
const flat = (s) => String(s).replace(/[\r\n]+/g, ' ')

function readOr(f) {
  try {
    return fs.readFileSync(f, 'utf8')
  } catch {
    return null
  }
}

// The deepest existing ancestor of <p> through realpath, the rest appended, as in hooks/plan-boundary.js.
function canonical(p) {
  const rest = []
  let cur = p
  while (!fs.lstatSync(cur, { throwIfNoEntry: false })) {
    const up = path.dirname(cur)
    if (up === cur) break
    rest.unshift(path.basename(cur))
    cur = up
  }
  return path.join(fs.realpathSync(cur), ...rest)
}

// Refuses an S a worker could write: inside the main checkout, a worktree, the sandbox's allowWrite, or an allowWrite
// that a settings file merges into every worker's sandbox.
function checkStateDir() {
  const trees = (git(['worktree', 'list', '--porcelain']) || '').split('\n').filter((l) => l.startsWith('worktree ')).map((l) => l.slice(9))
  const extra = []
  for (const f of SETTINGS_FILES) {
    let a
    try {
      a = JSON.parse(fs.readFileSync(f, 'utf8'))?.sandbox?.filesystem?.allowWrite
    } catch {
      continue
    }
    if (!Array.isArray(a)) continue
    for (const p of a) if (typeof p === 'string' && p) extra.push(p === '~' || p.startsWith('~/') ? path.join(HOME, p.slice(1)) : path.resolve(ROOT, p))
  }
  for (const p of [ROOT, ...trees, ...ALLOW_WRITE, ...extra]) {
    const c = canonical(p)
    const r = path.relative(c, S)
    if (r === '' || (r !== '..' && !r.startsWith(`..${path.sep}`) && !path.isAbsolute(r))) die(`state dir ${S} is inside ${c}`)
  }
}

function readConfig() {
  const f = path.join(ROOT, '.claude', '10x.json')
  const text = readOr(f)
  if (text === null) return {}
  try {
    const c = JSON.parse(text)
    return c && typeof c === 'object' ? c : {}
  } catch (e) {
    die(`cannot read ${f}: ${e.message}`)
  }
}

function parallel() {
  const v = config.batch && typeof config.batch === 'object' ? config.batch.parallel : undefined
  if (v == null) return 1
  if (!Number.isInteger(v) || v < 1) die(`batch.parallel must be an integer ≥ 1, got ${JSON.stringify(v)}`)
  return v
}

// A fresh file renamed into place, so a concurrent reader never sees half of it; `wx` never follows a planted path.
function put(file, text) {
  const tmp = `${file}.${process.pid}.tmp`
  fs.writeFileSync(tmp, text, { flag: 'wx' })
  fs.renameSync(tmp, file)
}

function git(argv) {
  try {
    return execFileSync('git', ['-C', ROOT, ...argv], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()
  } catch {
    return null
  }
}

// ---------------------------------------------------------------- init

function init(argv) {
  const items = []
  let searched = false
  let auto = false
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--auto') auto = true
    else if (argv[i] !== '--search') items.push({ arg: argv[i] })
    else if (searched || i + 1 >= argv.length) die(USAGE)
    else {
      searched = true
      items.push({ search: argv[++i] })
    }
  }
  if (!items.length) die(USAGE)
  const ids = []
  const errors = []
  const versions = []
  const closed = []
  const add = (id) => ids.includes(id) || ids.push(id)
  for (const it of items) {
    if (it.search === undefined) {
      const r = resolve(it.arg)
      if (r.refused) {
        errors.push(r.refused)
        continue
      }
      const v = r.id || !ID.test(it.arg) || /^[0-9]+$/.test(it.arg) ? null : version(it.arg)
      if (r.id) add(r.id)
      else if (!v) errors.push(`no ticket: ${it.arg}${r.why ? ` (${flat(r.why)})` : ''}`)
      else if (v.why) errors.push(v.why)
      else {
        versions.includes(it.arg) || versions.push(it.arg)
        for (const id of v.ids) {
          if (fs.existsSync(path.join(tdir(id), 'landed'))) {
            closed.includes(id) || closed.push(id)
            continue
          }
          const m = roadmap.GH.test(id) ? id.slice(3) : null
          const s = m ? issueState(m) : {}
          if (s.why) errors.push(`no ticket: ${it.arg} → ${id} (${flat(s.why)})`)
          else if (s.state === 'CLOSED') closed.includes(id) || closed.push(id)
          else {
            const t = resolve(id)
            if (t.id) add(t.id)
            else if (t.refused) errors.push(t.refused)
            else errors.push(`no ticket: ${it.arg} → ${id}${t.why ? ` (${flat(t.why)})` : ''}`)
          }
        }
      }
      continue
    }
    const label = `--search ${JSON.stringify(it.search)}`
    const s = search(it.search)
    if (s.why) {
      errors.push(`no ticket: ${label} (${flat(s.why)})`)
      continue
    }
    for (const n of s.numbers) {
      const r = fetchGh(n)
      if (r.id) add(r.id)
      else if (r.refused) errors.push(r.refused)
      else errors.push(`no ticket: ${label} → #${n} (${flat(r.why)})`)
    }
  }
  if (errors.length) {
    for (const e of errors) process.stderr.write(`10x-batch: ${e}\n`)
    process.exit(2)
  }
  // A ticket named directly is batched again, never also counted as landed.
  for (let k = closed.length - 1; k >= 0; k--) if (ids.includes(closed[k])) closed.splice(k, 1)
  // Its workers may still be running, and only the previous version knows where its records are.
  if (fs.existsSync(path.join(BATCH, 'tickets')) && !fs.existsSync(TICKETS))
    die(`${rel(BATCH)} is a batch from before the state dir; finish it with the previous version, or move it away`)
  if (fs.existsSync(BATCH) && fs.existsSync(TICKETS)) {
    const open = deriveAll(readIds()).filter((r) => !SETTLED.has(r.phase))
    if (open.length) die(`the batch in ${rel(BATCH)} has unsettled tickets: ${open.map((r) => `${r.id} (${r.phase})`).join(', ')}`)
  }
  if (fs.existsSync(BATCH) || fs.existsSync(SB)) archive()
  // A ticket batched again needs a new approval.
  for (const id of ids) {
    fs.rmSync(approval(id), { force: true })
    fs.rmSync(commenters(id), { force: true })
    const logins = roadmap.GH.test(id) ? ticketCommenters(id) : null
    if (logins) {
      mkd(S)
      put(commenters(id), logins.map((l) => l + '\n').join(''))
    }
  }
  mkd(SB)
  for (const id of ids) {
    fs.mkdirSync(bdir(id), { recursive: true })
    mkd(sdir(id))
  }
  put(MODE, `${auto ? 'auto' : 'default'}\n`)
  put(TICKETS, ids.join('\n') + '\n')
  if (versions.length) put(VERSIONS, versions.join('\n') + '\n')
  if (closed.length) put(CLOSED, closed.join('\n') + '\n')
  report(deriveAll(ids))
}

// The ticket ids of roadmap version <v>, { why } for a version that cannot be batched, or null when the roadmap has no
// such version.
function version(v) {
  const text = readOr(ROADMAP)
  if (text === null) return null
  const p = roadmap.parse(text, roadmap.ticketTest(TENX_DIR))
  const row = p.rows.find((r) => r.version === v)
  if (!row) return null
  if (p.faults.length) return { why: `no ticket: ${v} (${rel(ROADMAP)}:${p.faults[0].line}: ${p.faults[0].why})` }
  if (!row.ids.length) return { why: `version ${v} has no ticket ids: run /10x:roadmap tickets ${v}` }
  return { ids: row.ids }
}

// The state gh reports for issue <n> of origin's repo: { state } or { why }.
function issueState(n) {
  const o = originRepo()
  if (o.why) return o
  const r = spawnSync('gh', ['issue', 'view', n, '--repo', `github.com/${o.repo}`, '--json', 'state'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
  if (r.error) return { why: r.error.code === 'ENOENT' ? '`gh` is not installed' : r.error.message }
  if (r.status !== 0) return { why: (r.stderr || 'gh failed').trim() }
  try {
    return { state: String(JSON.parse(r.stdout).state) }
  } catch {
    return { why: `gh answered with something other than JSON: ${r.stdout.trim().slice(0, 200)}` }
  }
}

function resolve(a) {
  let m
  if ((m = /^(?:#|gh-)?([1-9][0-9]*)$/.exec(a))) return fetchGh(m[1])
  if ((m = /^https:\/\/github\.com\/([A-Za-z0-9._-]+\/[A-Za-z0-9._-]+)\/issues\/([1-9][0-9]*)\/?$/.exec(a))) {
    const o = originRepo()
    if (o.why) return o
    if (m[1].toLowerCase() !== o.repo.toLowerCase()) return { why: `not an issue of origin's repo ${o.repo}` }
    return fetchGh(m[2])
  }
  if (!ID.test(a)) return { why: 'neither a ticket id, an issue number nor an issue URL' }
  if (!fs.existsSync(path.join(tdir(a), 'ticket.md'))) return { why: `no ${rel(path.join(tdir(a), 'ticket.md'))}` }
  return { id: a }
}

// gh-<n>, its ticket.md written by 10x-ticket every time, so init records commenters from the issue and never from a
// file an earlier batch's worker may have edited; { refused } when the issue is not the user's. An existing ticket.md
// is checked before it is fetched again, so a stranger's issue leaves it untouched.
function fetchGh(n) {
  const id = `gh-${n}`
  const ticket = path.join(tdir(id), 'ticket.md')
  const kept = fs.existsSync(ticket)
  if (kept) {
    const refused = owner(n)
    if (refused) return { refused }
  }
  const existed = fs.existsSync(tdir(id))
  const step = (bin, argv) => {
    const r = spawnSync(path.join(__dirname, bin), argv, { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
    return r.status === 0 ? null : (r.stderr || r.stdout || `${bin} failed`).trim() || `${bin} failed`
  }
  const why = step('10x-worktree', ['init', id]) || step('10x-ticket', ['github', n, '--out', ticket])
  if (kept) return why ? { why } : { id }
  const refused = why ? null : owner(n)
  if (!why && !refused) return { id }
  if (!existed) fs.rmSync(tdir(id), { recursive: true, force: true })
  return why ? { why } : { refused }
}

let login = null
// null when issue <n> of origin's repo was written by the `gh` login, else the refusal line: a batch worker acts on
// its ticket's text unattended, so a stranger's issue could steer it. The login comes from `gh api user --jq .login`,
// once per process, the author from `gh issue view <n> --json author`; they compare case-insensitively.
const ghRun = (argv) => {
  const r = spawnSync('gh', argv, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
  if (r.error) return { why: r.error.code === 'ENOENT' ? '`gh` is not installed' : r.error.message }
  if (r.status !== 0) return { why: (r.stderr || 'gh failed').trim() }
  return { out: r.stdout.trim() }
}

function owner(n) {
  const cannot = (why) => `cannot check the author of gh-${n}: ${flat(why)}`
  const o = originRepo()
  if (o.why) return cannot(o.why)
  if (login === null) {
    const u = ghRun(['api', 'user', '--jq', '.login'])
    if (u.why) return cannot(u.why)
    if (!u.out) return cannot('gh api user printed no login')
    login = u.out
  }
  const v = ghRun(['issue', 'view', n, '--repo', `github.com/${o.repo}`, '--json', 'author'])
  if (v.why) return cannot(v.why)
  let author
  try {
    author = JSON.parse(v.out).author
  } catch {
    return cannot(`gh answered with something other than JSON: ${v.out.slice(0, 200)}`)
  }
  const who = author && typeof author.login === 'string' && author.login ? author.login : null
  if (who && who.toLowerCase() === login.toLowerCase()) return null
  return `not your issue: gh-${n} (author ${who || 'unknown'})`
}

// The comment authors 10x-ticket wrote under `## Comments` in ticket <id>'s ticket.md, lowercased; null when the file
// is missing or the section has no author line.
function ticketCommenters(id) {
  const text = readOr(path.join(tdir(id), 'ticket.md'))
  if (text === null) return null
  const lines = text.split('\n')
  const at = lines.indexOf('## Comments')
  if (at === -1) return []
  const read = lines.slice(at + 1).map((l) => /^\*\*(.+)\*\* \([0-9]{4}-[0-9]{2}-[0-9]{2}\):$/.exec(l)).filter(Boolean)
  return read.length ? read.map((m) => m[1].toLowerCase()) : null
}

// True when a comment on issue <n> is by someone other than the issue's author, or when that cannot be told: ticket.md
// carries every comment, so auto mode leaves such a plan for the human to approve. Both the issue as it is now and the
// authors init recorded from the ticket.md the worker read are checked, so a comment deleted after `init`, or dropped
// from ticket.md by the worker, still counts; no record holds the plan.
function strangerComments(n) {
  const o = originRepo()
  if (o.why) return true
  const v = ghRun(['issue', 'view', n, '--repo', `github.com/${o.repo}`, '--json', 'author,comments'])
  if (v.why) return true
  let who, logins
  try {
    const { author, comments } = JSON.parse(v.out)
    who = author?.login
    if (typeof who !== 'string' || !who || !Array.isArray(comments)) return true
    logins = comments.map((c) => c?.author?.login)
  } catch {
    return true
  }
  const seen = readOr(commenters(`gh-${n}`))
  if (seen === null) return true
  logins.push(...seen.split('\n').filter(Boolean))
  return logins.some((l) => typeof l !== 'string' || l.toLowerCase() !== who.toLowerCase())
}

function search(q) {
  const o = originRepo()
  if (o.why) return o
  const r = spawnSync('gh', ['issue', 'list', '--repo', `github.com/${o.repo}`, '--state', 'open', '--search', q, '--json', 'number', '--limit', '100'], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  })
  if (r.error) return { why: r.error.code === 'ENOENT' ? '`gh` is not installed' : r.error.message }
  if (r.status !== 0) return { why: (r.stderr || 'gh failed').trim() }
  let numbers
  try {
    numbers = JSON.parse(r.stdout).map((i) => String(i.number))
  } catch {
    return { why: `gh answered with something other than a JSON list: ${r.stdout.trim().slice(0, 200)}` }
  }
  numbers = numbers.filter((n) => /^[1-9][0-9]*$/.test(n))
  return numbers.length ? { numbers } : { why: 'no open issue matches' }
}

// OWNER/REPO of origin on github.com, derived as 10x-ticket derives it.
function originRepo() {
  let url = git(['remote', 'get-url', 'origin'])
  if (url === null) return { why: 'no origin remote' }
  url = url.replace(/\/$/, '').replace(/\.git$/, '')
  let host = ''
  let p = ''
  const scheme = /^[^:/]+:\/\/([^/]*)\/(.*)$/.exec(url)
  const scp = /^(?:[^/:]+@)?([^/:]+):(.+)$/.exec(url)
  if (scheme) [host, p] = [scheme[1].replace(/^.*@/, '').replace(/:.*$/, ''), scheme[2]]
  else if (scp) [host, p] = [scp[1], scp[2]]
  if (host !== 'github.com') return { why: `needs a github.com origin, got '${url}'` }
  const repo = p.split('/').slice(-2).join('/')
  if (!/^[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+$/.test(repo)) return { why: 'cannot derive OWNER/REPO from origin' }
  return { repo }
}

const today = (d = new Date()) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`

function archive() {
  const d = new Date()
  const stamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`
  let s = stamp
  for (let k = 2; fs.existsSync(`${BATCH}.${s}`) || fs.existsSync(`${SB}.${s}`); k++) s = `${stamp}-${k}`
  for (const d of [BATCH, SB]) if (fs.existsSync(d)) fs.renameSync(d, `${d}.${s}`)
}

// ---------------------------------------------------------------- records and phases

const mode = () => ((readOr(MODE) || '').trim() === 'auto' ? 'auto' : 'default')

function readIds() {
  const text = readOr(TICKETS)
  if (text === null) die('no batch: run `10x-batch init <tickets>` first')
  return text
    .split('\n')
    .map((s) => s.trim())
    .filter((s) => ID.test(s))
}

function runs(id) {
  const text = readOr(path.join(sdir(id), 'runs.tsv'))
  if (text === null) return []
  return text
    .split('\n')
    .slice(1)
    .filter(Boolean)
    .map((l) => {
      const c = l.split('\t')
      return Object.fromEntries(HEADER.map((h, i) => [h, c[i] ?? '']))
    })
}

function writeRuns(id, rows) {
  put(path.join(sdir(id), 'runs.tsv'), [HEADER, ...rows.map((r) => HEADER.map((h) => r[h]))].map((c) => c.join('\t') + '\n').join(''))
}

function alive(pid) {
  const n = Number(pid)
  if (!Number.isInteger(n) || n <= 0) return false
  try {
    process.kill(n, 0)
    return true
  } catch {
    return false
  }
}

// The run's worker, not a pid runs.tsv was made to name: a live process whose arguments hold the run's session uuid
// right after --session-id or --resume.
function ours(r) {
  if (!alive(r.pid) || !UUID.test(r.session)) return false
  const ps = spawnSync('ps', ['-o', 'command=', '-p', String(Number(r.pid))], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  const args = ps.status === 0 ? ps.stdout.trim().split(/\s+/) : []
  return args.some((a, k) => (a === '--session-id' || a === '--resume') && args[k + 1] === r.session)
}

const isOpen = (r) => r.end === '' && r.exit === ''

// The shared path of two `## Files` lists: equal, or one a directory (`…/`) holding the other.
function overlap(a, b) {
  for (const x of a)
    for (const y of b) {
      if (x === y || (x.endsWith('/') && y.startsWith(x))) return x
      if (y.endsWith('/') && x.startsWith(y)) return y
    }
  return null
}

function deriveAll(ids) {
  const rows = []
  for (const id of ids) {
    const r = derive(id)
    if (!r.implemented && ['queued', 'waiting', 'approved'].includes(r.phase)) {
      for (const e of rows) {
        if (e.phase !== 'failed' && e.phase !== 'held') continue
        const p = overlap(r.files, e.files)
        if (p) {
          Object.assign(r, { phase: 'held', evidence: `shares ${p} with ${e.id} (${e.phase})`, approvable: false })
          break
        }
      }
    }
    rows.push(r)
  }
  // An approved ticket whose files a later ticket already holds — implemented, not landed — waits for it to land.
  rows.forEach((r, i) => {
    if (r.phase !== 'approved' || r.implemented) return
    for (const e of rows.slice(i + 1)) {
      if (!e.implemented || ['landed', 'pr-open', 'dropped'].includes(e.phase)) continue
      const p = overlap(r.files, e.files)
      if (p) {
        Object.assign(r, { phase: 'held', evidence: `shares ${p} with ${e.id} (${e.phase}), which implemented first` })
        break
      }
    }
  })
  // An approved relock changed a locked test: shown in every phase but dropped.
  for (const r of rows) {
    r.relocked = r.phase === 'dropped' ? [] : relocks(r.id)
    if (r.relocked.length) r.evidence = [r.evidence, ...r.relocked.map((x) => `relocked: ${x}`)].filter(Boolean).join('; ')
  }
  // `loop` approved the plan, not the user: shown first in every phase but dropped.
  for (const r of rows) {
    const hash = r.phase === 'dropped' ? '' : (readOr(path.join(sdir(r.id), 'auto-approved')) || '').trim()
    if (hash) r.evidence = [`auto-approved (sha256 ${hash.slice(0, 12)})`, r.evidence].filter(Boolean).join('; ')
  }
  // The latest run fell back from auto mode: the mode it ran in, unless it never started for want of its sandbox.
  for (const r of rows) {
    const mode = r.last && !r.sandbox ? (readOr(path.join(bdir(r.id), `${pad(r.last.n)}-fallback`)) || '').trim() : ''
    if (mode) r.evidence = [r.evidence, `auto mode unavailable: ran in ${mode}`].filter(Boolean).join('; ')
  }
  return rows
}

function derive(id) {
  const rs = runs(id)
  const last = rs[rs.length - 1]
  const planText = readOr(path.join(tdir(id), 'plan.md'))
  const turn = path.join(bdir(id), 'turn.md')
  const row = {
    id,
    last,
    session: last ? last.session : '',
    files: planText ? md.files(planText) : [],
    implemented: rs.some((r) => r.session_kind === 'implement'),
    approvable: false,
  }
  const set = (phase, evidence = fs.existsSync(turn) ? rel(turn) : '') =>
    Object.assign(row, { phase, evidence: row.denied ? [evidence, row.denied].filter(Boolean).join('; ') : evidence })
  if (fs.existsSync(path.join(sdir(id), 'dropped'))) return set('dropped', 'dropped by the user')
  if (!last) return set('queued', '')
  const open = isOpen(last)
  if (open && alive(last.pid)) return set(RUNNING[last.session_kind] || 'planning')
  const exit = open ? '?' : last.exit
  const tag = `run ${pad(last.n)} (${last.kind})`
  const denied = (readOr(path.join(bdir(id), `${pad(last.n)}-denials.tsv`)) || '').split('\n').filter(Boolean)
  if (denied.length) row.denied = `${tag} denied: ${denied.map((d) => d.split('\t').pop()).join('; ')}`
  if ((readOr(path.join(bdir(id), `${pad(last.n)}-sandbox`)) || '').trim() === 'unavailable') {
    row.sandbox = true
    return set('failed', 'sandbox unavailable')
  }
  if (exit !== '0') return set('failed', exit === '?' ? `${tag} ended without an exit code` : `${tag} exited ${exit}`)

  if (last.session_kind === 'plan') {
    if (planText && /^Status:\s*approved\s*$/m.test(planText)) {
      if ((readOr(approval(id)) || '').trim() === planHash(planText)) return set('approved')
      return set('failed', `plan.md says approved, but no approval of yours matches it (10x-batch approve ${id})`)
    }
    row.approvable = !!planText && /^Status:\s*draft\s*$/m.test(planText) && planCheck(id)
    return set('waiting')
  }
  if (last.session_kind === 'implement') {
    const gate = failedGate(id)
    if (gate) return set('failed', `gate FAIL: ${gate}`)
    const ev = evidence(id, planText)
    if (ev.open && !ev.asked) return set('failed', `open criterion: ${ev.open}`)
    if (ev.asked) return set('waiting', [...ev.asks, fs.existsSync(turn) ? rel(turn) : ''].filter(Boolean).join('; '))
    return set('implemented')
  }
  if (last.session_kind === 'close') {
    if (!fs.existsSync(path.join(WT_DIR, id))) return set('landed', (readOr(path.join(bdir(id), `${pad(last.n)}-landed`)) || '').trim() || landedOn())
    const url = CLOSE === 'pr' ? prOpen(id) : null
    if (url) return set('pr-open', url)
    return set('failed', `close did not land${fs.existsSync(turn) ? `; see ${rel(turn)}` : ''}`)
  }
  return set('failed', `${tag} has an unknown session kind '${last.session_kind}'`)
}

function planCheck(id) {
  return spawnSync(path.join(__dirname, '10x-plan-check'), [id], { cwd: ROOT, stdio: 'ignore' }).status === 0
}

// The first gate whose result column is FAIL in verify/summary.txt; its log tail lines are indented and skipped.
function failedGate(id) {
  const text = readOr(path.join(tdir(id), 'verify', 'summary.txt')) || ''
  for (const l of text.split('\n')) {
    if (/^\s/.test(l) || l.length < 34) continue
    if (/^FAIL\s/.test(l.slice(29))) return l.slice(0, 28).trim()
  }
  return null
}

// The first criterion of the plan that evidence.md leaves neither met, deferred nor asked, and the texts of its asked
// lines; the last line for a criterion wins, as in hooks/stop-gate.js.
function evidence(id, planText) {
  const crit = planText ? md.criteria(planText).map((c) => `AC${c.n}`) : []
  const raw = (readOr(path.join(tdir(id), 'evidence.md')) || '').split('\n')
  const outside = md.blank(raw, 0)
  const state = new Map()
  const asks = []
  raw.forEach((line, k) => {
    if (outside[k] === null) return
    const ac = /^\s*[-*+]\s+(AC\d+)\s*[—–:-]\s*(.*?)\s*$/.exec(line)
    if (ac) state.set(ac[1], ac[2])
    else if (/^\s*[-*+]\s+asked:\s*\S/.test(line)) asks.push(line.replace(/^\s*[-*+]\s+asked:\s*/, '').trim())
  })
  let open = null
  for (const ac of crit) {
    const v = state.get(ac)
    if (v === undefined) open ??= `${ac} has no line`
    else if (/^asked:/.test(v)) asks.push(v.replace(/^asked:\s*/, ''))
    else if (!/^(met|deferred):\s*\S/.test(v)) open ??= `${ac} — ${v}`
  }
  return { open, asked: asks.length > 0, asks }
}

// The reasons of relock.md's approved entries (`## Relock <n>` with a `reason` and an `approved` ruling), in order.
function relocks(id) {
  const raw = (readOr(path.join(tdir(id), 'relock.md')) || '').split('\n')
  const outside = md.blank(raw, 0)
  const entries = []
  raw.forEach((line, k) => {
    if (outside[k] === null) return
    if (/^##\s+Relock\b/.test(line)) entries.push({})
    const m = /^\s*[-*+]\s+(reason|ruling):\s*(.*?)\s*$/.exec(line)
    if (m && entries.length) entries[entries.length - 1][m[1]] = m[2]
  })
  return entries.filter((e) => e.reason && /^approved\s*[—:-]/i.test(e.ruling || '')).map((e) => e.reason)
}

// The base branch name: config `base`, else develop if origin has it, else origin's default, else main.
function baseBranch() {
  if (typeof config.base === 'string' && config.base) return config.base
  if (git(['show-ref', '--verify', '--quiet', 'refs/remotes/origin/develop']) !== null) return 'develop'
  return (git(['symbolic-ref', '--quiet', '--short', 'refs/remotes/origin/HEAD']) || '').replace(/^origin\//, '') || 'main'
}

// The ref base_ref in scripts/lib.sh picks: origin/<base> when origin has it, unless `close: local` and the local base
// contains it; else the local base.
function baseRef() {
  const b = baseBranch()
  if (git(['show-ref', '--verify', '--quiet', `refs/remotes/origin/${b}`]) === null) return b
  if (CLOSE === 'local' && git(['merge-base', '--is-ancestor', `refs/remotes/origin/${b}`, `refs/heads/${b}`]) !== null) return b
  return `origin/${b}`
}

function landedOn() {
  const base = baseBranch()
  const remote = git(['show-ref', '--verify', '--quiet', `refs/remotes/origin/${base}`]) !== null
  const ref = remote && CLOSE !== 'local' ? `refs/remotes/origin/${base}` : `refs/heads/${base}`
  const sha = git(['rev-parse', '--short', ref])
  return sha ? `landed on ${base} at ${sha}` : `landed (worktree removed)`
}

// The PR url when `10x-land check <id>` prints `pr: OPEN <url>`; only that line is read.
function prOpen(id) {
  const r = spawnSync(path.join(__dirname, '10x-land'), ['check', id], { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  const m = /^pr: OPEN (\S+)$/m.exec(r.stdout || '')
  return m ? m[1] : null
}

// ---------------------------------------------------------------- schedule

// Why ticket <i> cannot implement now, or null: an earlier unsettled ticket whose `## Files` are not known yet, or a
// shared path with a running ticket or an earlier one that has not landed.
function implementBlock(rows, i) {
  const r = rows[i]
  const unknown = rows.slice(0, i).find((e) => !SETTLED.has(e.phase) && !e.files.length)
  if (unknown) return `${unknown.id} (${unknown.phase}) has no plan with ## Files yet`
  for (const [j, e] of rows.entries()) {
    if (j === i) continue
    const busy = Object.values(RUNNING).includes(e.phase) || (j < i && !['landed', 'pr-open', 'dropped'].includes(e.phase))
    const p = busy && overlap(r.files, e.files)
    if (p) return `${r.id} shares ${p} with ${e.id} (${e.phase})`
  }
  return null
}

function actions(rows) {
  const out = []
  const planning = rows.some((r) => r.phase === 'planning')
  for (const r of rows) if (r.phase === 'queued') out.push(`plan ${r.id}`)
  for (const r of rows)
    if (r.phase === 'waiting' && (r.last.session_kind !== 'plan' || !planning)) out.push(`answer ${r.id}${r.approvable ? ' approvable' : ''}`)
  let slots = PARALLEL - implementing(rows).length
  rows.forEach((r, i) => {
    if (r.phase !== 'approved' || slots <= 0 || implementBlock(rows, i)) return
    out.push(`implement ${r.id}`)
    slots--
  })
  const c = closeCandidate(rows)
  if (c) out.push(`close ${c.id}`)
  if (rows.every((r) => SETTLED.has(r.phase))) out.push('done')
  return out
}

// The tickets holding a batch.parallel slot: implementing, or waiting on a question of their implement session.
const implementing = (rows) => rows.filter((r) => r.phase === 'implementing' || (r.phase === 'waiting' && r.last.session_kind === 'implement'))

function closeCandidate(rows) {
  if (rows.some((r) => r.phase === 'closing')) return null
  const i = rows.findIndex((r) => r.phase === 'implemented')
  return i >= 0 && rows.slice(0, i).every((r) => SETTLED.has(r.phase)) ? rows[i] : null
}

// Why `status` does not list <kind> for ticket <i>.
function refusal(rows, i, kind) {
  const r = rows[i]
  const want = { plan: 'queued', implement: 'approved', close: 'implemented' }[kind]
  if (r.phase !== want) return `${kind} ${r.id} refused: ${r.id} is ${r.phase}, not ${want}`
  if (kind === 'implement') {
    const open = implementing(rows).map((e) => `${e.id} (${e.phase})`)
    if (open.length >= PARALLEL) return `implement ${r.id} refused: batch.parallel is ${PARALLEL} and ${open.join(', ')} ${open.length > 1 ? 'hold' : 'holds'} the slots`
    const why = implementBlock(rows, i)
    if (why) return `implement ${r.id} refused: ${why}`
    return `implement ${r.id} refused: earlier approved tickets take the batch.parallel (${PARALLEL}) slots`
  }
  if (kind === 'close') {
    const closing = rows.find((e) => e.phase === 'closing')
    if (closing) return `close ${r.id} refused: ${closing.id} is closing`
    const early = rows.slice(0, i).find((e) => !SETTLED.has(e.phase))
    if (early) return `close ${r.id} refused: the earlier ticket ${early.id} is ${early.phase}`
  }
  return `${kind} ${r.id} refused`
}

// ---------------------------------------------------------------- board

function board(rows) {
  const cell = (s) => (s ? flat(s).replace(/\|/g, '\\|') : '—')
  const lines = ['# Batch board', '', `mode: ${mode()}`, '', '| # | Ticket | Phase | Session | Outcome | Evidence |', '|---|---|---|---|---|---|']
  rows.forEach((r, i) =>
    lines.push(`| ${i + 1} | ${r.id} | ${r.phase} | ${cell(r.session)} | ${SETTLED.has(r.phase) ? r.phase : '—'} | ${cell(r.evidence)} |`),
  )
  const need = []
  for (const r of rows) {
    if (r.phase === 'waiting') need.push(`- ${r.id} — waiting${r.approvable ? ', plan approvable' : ''}: ${r.evidence ? flat(r.evidence) : 'no turn recorded'}`)
    else if (r.phase === 'failed' || r.phase === 'held') need.push(`- ${r.id} — ${r.phase}: ${flat(r.evidence)}`)
    else if (r.phase === 'pr-open') need.push(`- ${r.id} — merge ${flat(r.evidence)}`)
    else if (r.denied) need.push(`- ${r.id} — ${r.phase}: ${flat(r.denied)}`)
    if (r.phase !== 'landed') for (const x of r.relocked) need.push(`- ${r.id} — relocked: ${flat(x)}`)
  }
  lines.push('', '## Needs the human', ...(need.length ? need : ['- none']))
  return lines.join('\n') + '\n'
}

function writeBoard(rows) {
  fs.mkdirSync(BATCH, { recursive: true })
  const text = board(rows)
  put(BOARD, text)
  return text
}

// Not in writeBoard(): background `run`s call that concurrently, and roadmap.md has no lock.
function report(rows) {
  const text = writeBoard(rows)
  const acts = actions(rows)
  const done = markDone(rows)
  process.stdout.write(text + (acts.length ? '\n' + acts.join('\n') + '\n' : '') + done.map((l) => l + '\n').join(''))
}

// Sets `Done <date>` on each recorded version whose ids have all landed or were closed at init; a version already done,
// gone from the roadmap, or in a roadmap that fails its check is left as it is.
function markDone(rows) {
  const names = (readOr(VERSIONS) || '').split('\n').map((s) => s.trim()).filter((s) => ID.test(s))
  if (!names.length || fs.lstatSync(ROADMAP, { throwIfNoEntry: false })?.isFile() !== true) return []
  let text = readOr(ROADMAP)
  const p = text === null ? null : roadmap.parse(text, roadmap.ticketTest(TENX_DIR))
  if (!p || p.faults.length) return []
  const landed = new Set([...rows.filter((r) => r.phase === 'landed').map((r) => r.id), ...(readOr(CLOSED) || '').split('\n').map((s) => s.trim())])
  const date = today()
  const out = []
  for (const v of names) {
    const row = p.rows.find((r) => r.version === v)
    if (!row || roadmap.isDone(row.state) || !row.ids.length || !row.ids.every((id) => landed.has(id))) continue
    text = roadmap.setState(text, v, `Done ${date}`)
    out.push(`roadmap: ${v} Done ${date}`)
  }
  if (out.length) put(ROADMAP, text)
  return out
}

// ---------------------------------------------------------------- commands

function status() {
  report(deriveAll(readIds()))
}

function ticketRows(id) {
  const ids = readIds()
  if (!ids.includes(id)) die(`${id} is not in this batch (${TICKETS})`)
  const rows = deriveAll(ids)
  return { ids, rows, i: ids.indexOf(id) }
}

async function run(argv) {
  if (argv.length !== 2 || !KINDS.includes(argv[1])) die(USAGE)
  const [id, kind] = argv
  const { ids, rows, i } = ticketRows(id)
  const r = rows[i]
  if (r.phase === 'dropped') die(`${kind} ${id} refused: ${id} is dropped`)
  if (roadmap.GH.test(id)) {
    const refused = owner(id.slice(3))
    if (refused) die(refused)
  }
  let prompt, flag, session, sessionKind
  const replyFile = path.join(bdir(id), 'reply.md')
  if (kind === 'reply') {
    if (!r.last) die(`reply ${id} refused: ${id} has no session to reply to`)
    if (Object.values(RUNNING).includes(r.phase)) die(`reply ${id} refused: ${id} is ${r.phase}; its run must end first`)
    // The round this ticket's question came from: plan-session runs that started before its latest run ended. Replies of
    // one round run together; `status` holds the next round until they have all ended.
    const ended = Number(r.last.end) || Infinity
    const planning = rows.filter((e) => e.phase === 'planning' && Number(e.last.start) < ended).map((e) => e.id)
    if (r.last.session_kind === 'plan' && planning.length)
      die(`reply ${id} refused: a planning round is answered once every planning run of it has ended (${planning.join(', ')} still planning)`)
    if (fs.lstatSync(replyFile, { throwIfNoEntry: false })?.isFile() !== true) die(`reply ${id} refused: no reply at ${rel(replyFile)}`)
    prompt = fs.readFileSync(replyFile, 'utf8')
    if (!prompt.trim()) die(`reply ${id} refused: ${rel(replyFile)} is empty`)
    // A worker would take it as a typed command, with that skill's grants.
    if (prompt.trimStart().startsWith('/')) die(`reply ${id} refused: ${rel(replyFile)} starts with '/'`)
    if (!UUID.test(r.last.session)) die(`reply ${id} refused: its latest session '${flat(r.last.session)}' is not a session id`)
    ;[flag, session, sessionKind] = ['--resume', r.last.session, r.last.session_kind]
  } else {
    if (!actions(rows).includes(`${kind} ${id}`)) die(refusal(rows, i, kind))
    prompt = kind === 'close' ? `/10x:close ${id}` : `/10x:work ${id}`
    ;[flag, session, sessionKind] = ['--session-id', randomUUID(), kind]
  }

  fs.mkdirSync(bdir(id), { recursive: true })
  mkd(sdir(id))
  const turn = path.join(bdir(id), 'turn.md')
  const bin = process.env.TENX_BATCH_CLAUDE || 'claude'
  // Every worker starts in auto mode. A plan session's writes are kept under .10x/<id>/ by hooks/plan-boundary.js, which
  // reads TENX_BATCH_PLAN_DIR; no other worker gets the variable, whatever this process inherited.
  // `claude -p` stops background tasks 10 minutes after the last turn unless CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS is 0,
  // which would kill /10x:work's delegated engineer agents; a value the user set is kept. TENX_BATCH makes this script
  // refuse to let the worker drive the batch.
  const env = { ...process.env, TENX_BATCH: '1', CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS: process.env.CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS ?? '0' }
  delete env.TENX_BATCH_PLAN_DIR
  if (sessionKind === 'plan') env.TENX_BATCH_PLAN_DIR = tdir(id)
  // The commands hooks/grant.js keeps in ALWAYS_ASK — keep the two lists the same. No worker needs them (the conductor
  // posts comments and approves), so every run is denied them rather than left to auto mode's classifier. Each of them
  // also refuses on its own under TENX_BATCH (tests/batch.test.sh checks every one), so a full path or `sh -c` that
  // slips past these rules still fails.
  const denied = [
    '10x-land issue',
    '10x-land comment',
    '10x-land advisory',
    '10x-batch approve',
    '10x-batch init',
    '10x-batch accept-green',
    '10x-security set',
    '10x-security remove',
    '10x-security ticket',
  ]
    .flatMap((c) => [`Bash(${c}:*)`, `Bash(${c} *)`])
    // The sandbox wraps only Bash: Write and Edit would otherwise reach the records, settings that widen the sandbox,
    // and files a process outside the sandbox runs.
    .concat([`${S}/**`, ...SETTINGS_FILES, ...writeDeny()].map((p) => `Edit(/${p})`))
  // Today's mode for the session kind, used only when auto mode is unavailable.
  const fallback = sessionKind === 'plan' ? ['default', '--allowedTools', `Edit(.10x/${id}/**)`] : ['acceptEdits']
  const live = { child: null, signalled: false }
  for (const s of ['SIGTERM', 'SIGINT'])
    process.on(s, () => {
      live.signalled = true
      try {
        live.child?.kill(s)
      } catch {}
    })

  // One worker run, recorded in runs.tsv. Started in auto mode, its stream-json's init event is read as soon as its line
  // is complete: reporting another permission mode, it means auto mode is unavailable, and the worker is stopped.
  // The prompt goes after `--`, so a reply starting with `-` is never an option.
  const once = async (mode, sess) => {
    const prev = runs(id)
    const n = prev.length + 1
    const nn = pad(n)
    const log = path.join(bdir(id), `${nn}-${kind}.jsonl`)
    put(turn, '')
    const out = fs.openSync(log, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_TRUNC | fs.constants.O_NOFOLLOW)
    const child = spawn(bin, ['-p', '--output-format', 'stream-json', '--verbose', '--settings', SANDBOX, '--permission-mode', ...mode, '--disallowedTools', ...denied, flag, sess, '--', prompt], {
      cwd: ROOT,
      stdio: ['ignore', out, 'inherit'],
      env,
    })
    live.child = child
    fs.closeSync(out)
    let ended = false
    const exited = new Promise((res) => {
      child.on('error', (e) => {
        process.stderr.write(`10x-batch: cannot start ${bin}: ${e.message}\n`)
        res(null)
      })
      child.on('exit', (code, sig) => res(code ?? 128 + (os.constants.signals[sig] || 0)))
    }).finally(() => (ended = true))
    const row = { n: String(n), kind, session: sess, session_kind: sessionKind, start: String(Date.now()), end: '', exit: '', pid: child.pid ? String(child.pid) : '' }
    writeRuns(id, [...prev, row])
    if (mode[0] !== 'auto') put(path.join(bdir(id), `${nn}-fallback`), mode[0] + '\n')
    // The board shows the running worker and its session for as long as it runs.
    writeBoard(deriveAll(ids))
    if (kind === 'reply' && child.pid) {
      put(path.join(bdir(id), `${nn}-reply.md`), prompt)
      fs.rmSync(replyFile, { force: true })
    }
    let init = null
    if (mode[0] === 'auto' && child.pid) {
      while ((init = initMode(log)) === undefined && !ended) await new Promise((res) => setTimeout(res, 100))
      if (init === undefined) init = initMode(log) ?? null
      if (typeof init === 'string' && init !== 'auto') {
        try {
          child.kill('SIGTERM')
        } catch {}
      }
    }

    const code = await exited
    const { texts, denials, sandbox } = readLog(log)
    put(turn, texts.length ? texts.join('\n\n') + '\n' : '')
    put(path.join(bdir(id), `${nn}-denials.tsv`), denials.map((d) => d + '\n').join(''))
    if (sandbox) put(path.join(bdir(id), `${nn}-sandbox`), 'unavailable\n')
    const now = runs(id).map((x) => (x.n === row.n ? { ...x, end: String(Date.now()), exit: String(code ?? 127) } : x))
    writeRuns(id, now)
    // Where it landed, read now: the base moves on as later tickets land.
    if (kind === 'close' && code === 0 && !fs.existsSync(path.join(WT_DIR, id))) put(path.join(bdir(id), `${nn}-landed`), landedOn() + '\n')
    return { code, unavailable: typeof init === 'string' && init !== 'auto' }
  }

  let res = await once(['auto'], session)
  // The turn again in today's mode, unless the ticket was dropped or this process stopped meanwhile. A rerun is never
  // checked for its own init; plan, implement and close start a new session, a reply resumes the same one.
  // A worker whose sandbox is unavailable writes no init event, so it is never rerun.
  if (res.unavailable && !live.signalled && !fs.existsSync(path.join(sdir(id), 'dropped')))
    res = await once(fallback, kind === 'reply' ? session : randomUUID())
  const after = deriveAll(ids)
  writeBoard(after)
  if (res.code === null) process.exit(2)
  process.stdout.write(`phase: ${after[i].phase}\nboard: ${BOARD}\n`)
  process.exit(0)
}

// The permissionMode of a stream-json log's init event, read from its complete lines: other system events (SessionStart
// hooks) may come first. undefined while no init line is there yet; null when the init names no mode, or when an event
// that is not a system one comes first (init precedes every turn).
function initMode(file) {
  const text = readOr(file) || ''
  for (const l of text.slice(0, text.lastIndexOf('\n') + 1).split('\n')) {
    if (!l.trim()) continue
    let ev
    try {
      ev = JSON.parse(l)
    } catch {
      continue
    }
    if (!ev || ev.type !== 'system') return null
    if (ev.subtype === 'init') return typeof ev.permissionMode === 'string' ? ev.permissionMode : null
  }
  return undefined
}

// Every top-level assistant text block of a stream-json log, in order, its permission denials, and whether Claude Code
// refused to start without its sandbox.
function readLog(file) {
  const texts = []
  const denied = new Map()
  let sandbox = false
  for (const l of (readOr(file) || '').split('\n')) {
    if (!l.trim()) continue
    let ev
    try {
      ev = JSON.parse(l)
    } catch {
      continue
    }
    if (ev.type === 'assistant' && ev.parent_tool_use_id == null && Array.isArray(ev.message?.content)) {
      for (const c of ev.message.content) if (c.type === 'text' && typeof c.text === 'string' && c.text.trim()) texts.push(c.text.trim())
    } else if (ev.type === 'result') {
      for (const d of ev.permission_denials || []) denied.set(d.tool_use_id, d)
      if (ev.startup_failure_reason === 'sandbox_required_unavailable') sandbox = true
    }
  }
  const denials = [...denied.values()].map((d) => {
    const tool = flat(d.tool_name || 'unknown')
    return `${tool}\t${flat((d.tool_input && (d.tool_input.command || d.tool_input.file_path)) || tool)}`
  })
  return { texts, denials, sandbox }
}

function drop(argv) {
  if (argv.length !== 1) die(USAGE)
  const [id] = argv
  const { ids } = ticketRows(id)
  mkd(sdir(id))
  put(path.join(sdir(id), 'dropped'), `${new Date().toISOString()}\n`)
  const last = runs(id).at(-1)
  if (last && isOpen(last) && ours(last)) {
    try {
      process.kill(Number(last.pid), 'SIGTERM')
    } catch {}
  }
  writeBoard(deriveAll(ids))
  process.stdout.write(`dropped: ${id}\nboard: ${BOARD}\n`)
}

function approve(argv) {
  if (argv.length !== 1) die(USAGE)
  const [id] = argv
  const { rows, i } = ticketRows(id)
  const r = rows[i]
  if (r.phase !== 'waiting' || !r.approvable) die(`approve ${id} refused: ${id} is ${r.phase}${r.phase === 'waiting' ? ' and its plan.md is not a draft that passes 10x-plan-check' : ''}`)
  const hash = recordApproval(id)
  process.stdout.write(`approved: ${id}\nplan: ${rel(path.join(tdir(id), 'plan.md'))} sha256 ${hash.slice(0, 12)}\nreply: ${rel(path.join(bdir(id), 'reply.md'))}\n`)
}

// The approval record of ticket <id>'s plan.md and the approve reply; returns the hash.
function recordApproval(id) {
  mkd(S)
  const hash = planHash(fs.readFileSync(path.join(tdir(id), 'plan.md'), 'utf8'))
  put(approval(id), hash + '\n')
  fs.mkdirSync(bdir(id), { recursive: true })
  put(path.join(bdir(id), 'reply.md'), APPROVE_REPLY)
  return hash
}

// The user's acceptance of a test file that stays GREEN in red-proof: an entry of S/batch/<id>/accepted-green.md, which
// red-proof and the review packet read for a batch ticket instead of .10x/<id>/accepted-green.md.
function acceptGreen(argv) {
  if (argv.length !== 3) die(USAGE)
  const [id, arg] = argv
  if (!readIds().includes(id)) die(`${id} is not in this batch (${TICKETS})`)
  if (fs.existsSync(path.join(sdir(id), 'dropped'))) die(`accept-green ${id} refused: ${id} is dropped`)
  const reason = flat(argv[2]).trim()
  if (!reason) die(`accept-green ${id} refused: the reason is empty`)
  const file = arg.replace(/^\.\//, '')
  if (!file || /[\x00-\x1f\x7f]/.test(file) || path.isAbsolute(file) || file.split('/').includes('..'))
    die(`accept-green ${id} refused: '${flat(arg)}' is not a path relative to the worktree root`)
  const wt = path.join(WT_DIR, id)
  if (!fs.existsSync(path.join(wt, '.git'))) die(`accept-green ${id} refused: ${id} has no worktree at ${wt}`)
  const wtGit = (a) => git(['-C', wt, ...a])
  const ref = baseRef()
  const mb = wtGit(['merge-base', ref, 'HEAD'])
  if (!mb) die(`accept-green ${id} refused: no merge base with ${ref}`)
  // The test files red-proof runs: redProof.tests when redProof.command is set (the worktree's config, else the main
  // checkout's), else its JavaScript test-file pattern.
  const cfgFile = [path.join(wt, '.claude', '10x.json'), path.join(ROOT, '.claude', '10x.json')].find((f) => fs.existsSync(f))
  let rp
  try {
    rp = cfgFile ? JSON.parse(fs.readFileSync(cfgFile, 'utf8'))?.redProof : undefined
  } catch (e) {
    die(`cannot read ${cfgFile}: ${e.message}`)
  }
  const cmd = rp?.command == null ? '' : String(rp.command)
  const globs = cmd ? (Array.isArray(rp.tests) ? rp.tests : rp.tests == null ? [] : [rp.tests]).map(String).filter(Boolean) : []
  if (cmd && !globs.length) die('redProof.command is set but redProof.tests is missing (git pathspec globs naming the test files)')
  const out = wtGit(['diff', '-z', '--name-only', '--no-renames', '--diff-filter=AMT', mb, 'HEAD', ...(cmd ? ['--', ...globs.map((g) => `:(glob)${g}`)] : [])])
  if (out === null) die(`accept-green ${id} refused: cannot list the files the branch changes`)
  const tests = out.split('\0').filter((f) => f && (cmd || /\.(test|spec)\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$/.test(f)))
  if (!tests.includes(file)) die(`accept-green ${id} refused: ${flat(file)} is not a test file the branch adds or modifies`)
  const blob = wtGit(['rev-parse', `HEAD:${file}`])
  if (!blob) die(`accept-green ${id} refused: no blob for ${flat(file)} at HEAD`)
  mkd(sdir(id))
  const rec = path.join(sdir(id), 'accepted-green.md')
  const old = (readOr(rec) || '').trimEnd()
  const entry = `## Accepted ${(old.match(/^## Accepted/gm) || []).length + 1}\n- file: ${file}\n- blob: ${blob}\n- reason: ${reason}\n`
  put(rec, old ? `${old}\n\n${entry}` : entry)
  process.stdout.write(`accepted: ${id} ${file} blob ${blob.slice(0, 12)}\n`)
}

// ---------------------------------------------------------------- loop

// A product question is the human's: the worker's comment for the issue, or its list of product questions.
const heldBack = (id) => fs.existsSync(path.join(tdir(id), 'comment.md')) || fs.existsSync(path.join(tdir(id), 'product-questions.md'))

const fixedSent = (id) => {
  let names = []
  try {
    names = fs.readdirSync(bdir(id))
  } catch {}
  return names.filter((f) => /^[0-9]+-reply\.md$/.test(f) && readOr(path.join(bdir(id), f)) === FIXED_REPLY).length
}

async function loop(argv) {
  if (argv.length) die(USAGE)
  const ids = readIds()
  const auto = mode() === 'auto'
  const own = new Map()
  const refused = new Map()
  const held = new Set()
  let woke = false
  let wake = null
  const sleep = (ms) => new Promise((res) => setTimeout(res, ms))
  const ownOpen = () => [...own.values()].some((c) => !c.exited)

  // A detached `run`, so stopping this process leaves it running. It returns once the run's row is recorded or the
  // run has ended, so the next pass derives it; false when it was refused before recording one.
  const start = async (id, kind) => {
    fs.mkdirSync(bdir(id), { recursive: true })
    const errFile = path.join(bdir(id), 'run.err')
    const before = runs(id).length
    const fd = fs.openSync(errFile, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_TRUNC | fs.constants.O_NOFOLLOW)
    const env = { ...process.env }
    delete env.TENX_BATCH
    const c = { exited: false, code: null, ran: false }
    const child = spawn(process.execPath, [__filename, 'run', id, kind], { cwd: ROOT, detached: true, stdio: ['ignore', 'ignore', fd], env })
    fs.closeSync(fd)
    // Only the end of a run that started wakes the loop: a refused one is retried at the next wake, not at once.
    const done = (code) => {
      if (c.exited) return
      Object.assign(c, { exited: true, code })
      if (!c.ran) return
      woke = true
      wake?.()
    }
    child.on('error', () => done(null))
    child.on('exit', (code) => done(code))
    own.set(id, c)
    while (!c.exited && runs(id).length === before) await sleep(50)
    if (!(c.exited && c.code === 2 && runs(id).length === before)) {
      c.ran = true
      if (c.exited) woke = true
      return true
    }
    const line = (readOr(errFile) || '').split('\n').filter((l) => l.startsWith('10x-batch: ')).pop()
    if (line && /^10x-batch: (not your issue|cannot check the author)/.test(line)) refused.set(id, line)
    return false
  }

  for (;;) {
    woke = false
    const rows = deriveAll(ids)
    writeBoard(rows)
    let started = false
    for (const a of actions(rows)) {
      const m = /^(plan|implement|close|answer) (\S+)( approvable)?$/.exec(a)
      if (!m) continue
      const [, kind, id] = m
      if (own.get(id)?.exited === false || refused.has(id)) continue
      if (kind !== 'answer') {
        started = (await start(id, kind)) || started
        continue
      }
      const r = rows.find((e) => e.id === id)
      const replyFile = path.join(bdir(id), 'reply.md')
      if (!fs.existsSync(replyFile) && auto && r.last.session_kind === 'plan' && !heldBack(id) && !held.has(id)) {
        if (r.approvable) {
          if (roadmap.GH.test(id) && strangerComments(id.slice(3))) held.add(id)
          else {
            const hash = recordApproval(id)
            mkd(sdir(id))
            put(path.join(sdir(id), 'auto-approved'), hash + '\n')
          }
        } else if (fixedSent(id) < FIXED_MAX) put(replyFile, FIXED_REPLY)
      }
      if (fs.existsSync(replyFile)) started = (await start(id, 'reply')) || started
    }
    const now = started ? null : deriveAll(ids)
    if (now && !ownOpen() && !now.some((r) => Object.values(RUNNING).includes(r.phase))) {
      writeBoard(now)
      markDone(now)
      process.stdout.write(JSON.stringify({ items: items(now, auto, refused, held) }) + '\n')
      process.exit(0)
    }
    if (!woke) {
      await new Promise((res) => {
        wake = res
        setTimeout(res, POLL_MS)
      })
      wake = null
    }
  }
}

// What the human is needed for, in board order, at most one item per ticket.
function items(rows, auto, refused, held) {
  const out = []
  for (const r of rows) {
    const item = (need, evidence) => out.push({ id: r.id, need, evidence })
    if (refused.has(r.id)) item('failed', refused.get(r.id))
    else if (r.phase === 'failed') item('failed', r.evidence)
    else if (r.phase === 'waiting') item(r.approvable && (!auto || heldBack(r.id) || held.has(r.id)) ? 'approve' : 'answer', r.evidence)
    else if (r.denied && !['landed', 'pr-open', 'dropped'].includes(r.phase)) item('denied', r.evidence)
  }
  if (out.length) return out
  return rows.every((r) => SETTLED.has(r.phase)) ? [{ need: 'done' }] : []
}

const [cmd, ...args] = process.argv.slice(2)
if (cmd === 'init') init(args)
else if (cmd === 'run') run(args)
else if (cmd === 'status' && !args.length) status()
else if (cmd === 'drop') drop(args)
else if (cmd === 'approve') approve(args)
else if (cmd === 'accept-green') acceptGreen(args)
else if (cmd === 'loop') loop(args)
else die(USAGE)
