#!/usr/bin/env node
// Schedules, records and lands a batch of tickets, each through `/10x:work` and `/10x:close` in its own
// `claude -p` worker; /10x:batch relays the workers' turns and the user's answers.
//
//   10x-batch init [--auto] <ticket>... [--search "<query>"]
//   10x-batch run <id> plan|reply|implement|close
//   10x-batch status
//   10x-batch drop <id>
//   10x-batch replan <id>
//   10x-batch approve <id>...
//   10x-batch accept-green <id> <file> "<reason>"
//   10x-batch checked <id> AC<n> "<what you saw>"
//   10x-batch loop
//
// With TENX_BATCH set (every worker has it), init, run, drop, replan, approve, accept-green, checked and loop refuse before reading
// anything, so a worker cannot drive its own batch; status still runs.
//
// The records a decision is made from live in the state dir S, out of every worker's reach: S is
// <base>/10x/<first 16 hex of the sha256 of the realpath of the git common dir>, canonical, where <base> is
// $XDG_STATE_HOME when it is absolute, else ~/.local/state. S/batch/ holds `tickets` (one id per line, board order),
// `mode` (`auto` or `default`; anything else, or no file, is default), `versions` and `versions.closed`, and per ticket
// <id>/: runs.tsv (`n kind session session_kind start end exit pid`, times in epoch ms, end and exit empty while a run
// is open), `auto-approved` (the plan hash `loop` approved), `dropped`, `accepted-green.md` (the GREEN test files the
// user accepted), reruns.tsv (`run gate head result exit log`, one record per host rerun), `rerun` (the pid of the
// `run` rerunning a gate) and `security` (the settled security entries of a landed ticket, below). S, S/batch and S/batch/<id> are made 0700, and a symlink at any of them is refused. init, run, drop,
// replan, approve, accept-green and loop first refuse an S equal to or inside the
// main checkout, a worktree, a path the worker sandbox may write, or a sandbox.filesystem.allowWrite of the project's
// or the user's .claude/settings.json or settings.local.json, or of the same two files in CLAUDE_CONFIG_DIR, when set,
// resolved against the main checkout (`state dir <S> is inside <path>`).
// The rest lives in the main checkout's .10x/_batch/: `board.md`, and per ticket <id>/: <nn>-<kind>.jsonl (the
// worker's stream-json), <nn>-denials.tsv (`<tool>\t<command, file or tool>`), turn.md (every assistant text of the
// latest run), reply.md (the next reply, moved to <nn>-reply.md once sent), <nn>-landed (the base and sha a close run
// left), <nn>-fallback (the mode a run started in when auto mode was unavailable), <nn>-sandbox (`unavailable` when
// the worker's sandbox was), <nn>-plugin (`missing` when the worker's init event listed no 10x:work), <nn>-rerun-<k>.log
// (the output of the k-th gate rerun on the host for run <nn>) and run.err (the stderr of loop's latest run). A phase is never stored: every command derives it from these files and
// .10x/<id>/.
//
// `init` resolves every argument before writing anything (`<n>`, `#<n>`, `gh-<n>`, an issue URL of origin's repo,
// `--search` once, or an id with .10x/<id>/ticket.md) and exits 2 naming each one that resolves to no ticket, and each
// gh-<n> whose author is not the `gh` login (`not your issue: gh-<n> (author <login>)`): a stranger's issue could
// steer a worker. `--auto` records the auto mode. An
// argument that resolves to no ticket, is a valid id and not a number is tried as a version of .10x/roadmap.md
// (scripts/roadmap.js): it resolves to the ticket ids of its row, each resolved as an argument, except an id with
// .10x/<id>/landed (written by `10x-worktree rm` once the branch landed), whatever its ticket source, and a gh-<n> whose
// issue is closed, which are left out; a row with no id exits 2. The version names go to `versions`, the landed and
// closed ids to `versions.closed`, less any id also named directly, which is batched again. A previous batch (one with
// S/batch/tickets) is refused while .10x/_batch/ exists and a ticket of it is unsettled; else .10x/_batch/ and S/batch/
// are archived to .10x/_batch.<YYYYMMDD-HHMMSS>/ and S/batch.<YYYYMMDD-HHMMSS>/, one stamp free in both. A
// .10x/_batch/tickets with no S/batch/tickets is a batch from before S, refused. The approval records of the tickets it
// takes in are deleted.
// `run` starts one worker turn and waits for it: ${TENX_BATCH_CLAUDE:-claude} -p … --output-format stream-json
// --verbose --plugin-dir <the directory above this script's bin/> --permission-mode auto, a plan session's worker with TENX_BATCH_PLAN_DIR set to .10x/<id> for
// hooks/plan-boundary.js, a new --session-id for plan, implement and close, --resume of the ticket's latest
// session for reply, the prompt after `--`. When the worker's stream-json init event reports another permission mode
// (auto mode unavailable), it is stopped and the turn runs again as a new run in the mode used before auto mode: a plan
// session in default with Edit(.10x/<id>/**) allowed, implement and close in acceptEdits. A run whose init event has
// no 10x:work among its slash_commands is stopped, writes <nn>-plugin, is never rerun, and its ticket fails with
// `10x plugin missing`. Every run gets
// --disallowedTools for the commands hooks/grant.js always asks for (10x-land issue/comment/decisions/advisory, 10x-batch
// approve/init/accept-green/checked, 10x-security set/remove/ticket, 10x-feedback issue/comment), Edit of S and of the settings files (the main
// checkout's .claude/, ~/.claude/ and, when set, $CLAUDE_CONFIG_DIR's settings.json and settings.local.json, each also
// as a real path and its symlink target), and Edit of what
// a process outside the sandbox runs (writeDeny(): the git common dir, every <worktree dir>/*/.git, the main checkout's
// .envrc and .claude/10x.json, the zsh files of $ZDOTDIR (with .zlogout and the compiled .zwc) and $HOME/.zshenv(.zwc), the bash (with
// .bash_logout), git, ssh and login-agent files of $HOME, the plugin
// root, ~/.claude.json, ~/.claude/plugins and ~/.claude/hooks and, when CLAUDE_CONFIG_DIR is set, its .claude.json,
// plugins and hooks, every absolute PATH entry and $PNPM_HOME, the npx, pnpm dlx and corepack caches and
// $COREPACK_HOME, each as a real path and, when a symlink, its target too), and --settings right
// after --verbose: Claude Code's sandbox, required (a worker whose sandbox is unavailable writes <nn>-sandbox and its
// ticket fails with `sandbox unavailable`, never run again), its writes kept to the temp dir, the npm and generic
// caches, ~/Library/Developer, /dev/stdout and /dev/fd — not ~/Library/pnpm: pnpm then falls back to a store in the
// temp dir, and the user's store and PNPM_HOME stay out of reach — and its denyWrite the same writeDeny() paths plus
// the settings files, except the git common dir, narrowed to config, config.worktree, hooks, info/attributes,
// commondir and the admin dir and .git file of every worktree registered when the run starts but the ticket's own.
// It and replan refuse a PATH entry or PNPM_HOME that is or contains the main checkout or an allowWrite path.
// It refuses a plan, implement or close that `status` does not list, a reply to a planning session while a plan-session run that started before the
// ticket's latest run ended is open, and a
// reply whose first line starts with `/`, and a gh-<n> ticket whose issue is no longer the user's. Before an implement
// run on an existing <worktree dir>/<id>, never before its auto-mode fallback rerun, it rebases the worktree's branch
// onto the base ref, git pinned with worktree.pin, after fetching origin/<base> when origin exists. A pin refusal, a
// failed fetch, a rebase in progress, uncommitted tracked changes (`uncommitted changes in <worktree>: <files>`) or a
// failed rebase (`rebase onto <ref> conflicts in <files>`, aborted) starts no worker: the branch is left as it was, a
// run row with exit 2 and no pid and <nn>-rebase (the reason) are recorded, so the ticket is `failed` with that reason,
// and it refuses (`implement <id> refused: <reason>`). Every worker gets
// TENX_BATCH=1. SIGTERM and SIGINT are forwarded to the worker. It prints
// `phase: <phase>` and `board: <path>`, exit 0 once the worker ran, whatever its exit code.
// With batch.hostRerun true, after an implement or close session's run (a reply in one included) exits 0, and while the
// ticket is not dropped and no signal came, each free `- asked: sandbox-red: <gate>` line of evidence.md is handled in
// order: refused (`refused: <why>`, recorded) when worktree.pin fails (head `-`) or <gate> is not exactly an entry of
// the main checkout's `gates` (one-line strings only), not run again when already recorded green or red at the
// worktree's HEAD, else run outside the sandbox as `bash -c <gate>` in <worktree dir>/<id>, stdin ignored, output to
// <nn>-rerun-<k>.log, env without TENX_BATCH_PLAN_DIR, signals forwarded to it; exit 0 is `green`, else `red`. While a
// gate runs, S/batch/<id>/rerun holds this pid and the ticket shows its session's running phase. Any red or refused
// gate ends it there; when at least one gate ran and all are green, it resumes the session as a `reply` run (auto mode,
// usual fallback) with each gate, where and at what commit it ran and the last 40 lines of its output, saved as
// <nn>-reply.md (reply.md left alone), and handles the next report the same way.
// `status` writes and prints the board, then the actions allowed now: `plan <id>`, `implement <id>`, `close <id>`,
// `answer <id>[ approvable]`, and `done` when every ticket is settled; after them, it and `init` print
// `no decisions: <id>` for each ticket, in board order, whose ticket.md has no decisions section (md-check.js
// hasDecisions), whose plan.md is not `Status: approved`, and with no run yet. A ticket `failed`, or `waiting` on a
// plan or implement session for over 30 minutes since its latest run ended (else started), is set aside: it holds no
// batch.parallel slot, no ticket waits on its Files and it holds back no later close. The board lists each under
// `## Set aside`, after `## Needs the human`, as `- <id> — <phase>, waiting <h>h <mm>m: <evidence>`; absent when none
// is. `## Host reruns`, right after `## Needs the human` and absent when there is none, lists every reruns.tsv record
// as `- <id> — <gate>: <result> (run <nn>, <worktree> at <short sha or ->)`. The board ends with `## Hand checks pending`,
// one line `- <version> — <id> AC<n>: <text>` per declared hand check whose last evidence.md line is `hand-check:`, of
// every landed ticket and id of `versions.closed`, a ticket in no recorded version under `(no version)`; absent when
// none is. `status` and `init` also set the State of each recorded version whose ids are all landed or closed, none
// with a hand check pending, to `Done <YYYY-MM-DD>` (local date) in .10x/roadmap.md, changing nothing else, once, and
// print `roadmap: <version> Done <date>` when they do.
// `approve` records the user's approval of each id's draft plan that passes 10x-plan-check: one record per id, the
// sha256 of plan.md with its Status line blanked, in S/<id>.approved, printing the plan's path and short hash, out of
// reach of every worker: its Bash runs in the sandbox, which cannot write S, and its Edit and Write tools are denied S.
// A plan session's ticket is `approved`
// only when plan.md says so and that record matches it. It then writes the approve reply to each id's reply.md. When
// any id is not in the batch or not approvable, it names each such id and writes nothing for any.
// `accept-green` records, on the user's go only, that a test file staying GREEN in 10x-red-proof is accepted: it
// appends `## Accepted <n>` with the file, its blob at the ticket worktree's HEAD and the reason (newlines flattened) to
// S/batch/<id>/accepted-green.md and prints `accepted: <id> <file> blob <12 hex>`. While the ticket is in the batch,
// red-proof and the review packet read only that record, never .10x/<id>/accepted-green.md, which a worker could
// write. It refuses a ticket not in the batch or dropped, one without a worktree, an empty reason, and a file that is
// not a test file (redProof.tests, else red-proof's *.test|spec.* pattern) the branch adds or modifies against the
// merge base with the base ref. No skill grants it, so each acceptance asks; it writes no reply.md.
// `checked` records, on the user's word only, that a pending hand check passed: it appends
// `- AC<n> — met: hand check by the user on <YYYY-MM-DD>: <words>` (newlines flattened) to .10x/<id>/evidence.md and
// prints `checked: <id> AC<n>`, for a ticket in the batch or not. It refuses empty words, a criterion the plan's
// `## Tests` does not declare a hand check or whose last state is not `hand-check:`, and a missing or symlinked
// .10x/<id>, plan.md or evidence.md. It writes no state dir, so it runs no state-dir check. No skill grants it.
// `loop` drives the batch until a human is needed: each pass writes the board, starts every plan, implement and close
// action and every reply whose reply.md exists as a detached `run`, and in auto mode approves a draft that passes
// 10x-plan-check (writing `auto-approved`) or sends a planning question FIXED_REPLY (at most 3 times; a question the
// ticket's decisions section answers is settled by it; the worker answers product questions too, marked `(product)`
// under `## Auto decisions`; a security or cost question it holds in .10x/<id>/held-questions.md, which then holds the
// ticket). A gh-<n> plan whose issue has a comment by someone other than its author is not approved, nor is a
// security-<8 hex> ticket's plan. A security-<8 hex> ticket gets SECURITY_FIXED_REPLY instead, and gets neither while
// .10x/<id>/comment.md or product-questions.md exists. In auto mode an implementation session waiting on asked lines
// none of which starts with a mark — `(security)`, `(cost)`, `(product)`, `(human)` — or is a sandbox-red ask gets
// PROCEED_REPLY, to take its recommendations (at most 3 times). It waits for one of its runs or 10 seconds between
// passes, and once nothing runs prints one line, {"items":[…]}: per ticket `failed`, `answer` or `approve` with its
// evidence — a ticket's denials make no item of their own — or [{"need":"done"}] when every ticket is settled.
// `drop` sends SIGTERM to the ticket's open worker (a process whose command line holds the run's session) and to a
// `10x-batch run <id>` rerunning a gate (the pid in S/batch/<id>/rerun), marks it dropped and rewrites the board.
// `replan` sends a `failed` ticket back to planning without a new batch; any other phase is refused (`replan <id>
// refused: <id> is <phase>, not failed`). After every refusal, and before its worker starts, it deletes S/<id>.approved,
// S/batch/<id>/auto-approved and .10x/_batch/<id>/reply.md, and rewrites the first `Status: approved` line of
// .10x/<id>/plan.md to `Status: draft`, so the ticket needs a new `approve`; a symlink at .10x/<id> or its plan.md is
// refused first. It then runs one plan-session worker turn as `run <id> plan` does, on the existing plan.md, and
// touches nothing else of the ticket or the batch.
//
// A permission denial does not fail a run: a run that exits 0 is judged by the ticket's files, and its denials are
// added to the evidence and listed under `## Needs the human` as `<N> denied (see .10x/_batch/<id>/<nn>-denials.tsv)`,
// never as the commands. Two such runs that would be `failed` are `waiting` when they have denials, so the user can
// allow the command and reply: an implement run that leaves a criterion open with no `asked` line, and a close run
// that did not land with no open PR. A ticket waiting on its implement session shows the
// `asked` texts of evidence.md; each approved entry of .10x/<id>/relock.md adds `relocked: <reason>` to the evidence
// and, until the ticket lands, under `## Needs the human`. Each top-level `- Decided: <text>` bullet under plan.md's
// `## Assumptions` (a question an implementation session proceeded on with its recommendation) is listed there too,
// as `decided: <text>`, until the ticket lands; it is not added to the evidence and nothing waits on it. A dropped
// ticket lists neither. A ticket whose latest run has a <nn>-fallback file adds
// `auto mode unavailable: ran in <mode>` to its evidence.
//
// Security entries of a landed ticket: `run` (after its worker, before the board) and every `loop` pass settle each
// landed ticket once, claimed by creating S/batch/<id>/security exclusively. Its candidates, each once, in order: the
// `Security: <fp>` header lines of ticket.md, each roadmap item linked to <id> ending ` (security <fp>)`, and for a
// `security-<8 hex>` id each security.md entry whose fp starts with those hex and whose `seen in` lists <id> — the
// ticket's own — then each fp in plan.md's `## Acceptance criteria`, never its own. An own entry is removed with
// `10x-security remove <found in> <fp>` (TENX_BATCH unset) when its `found in` is <id> or an audit run and the last
// `## Round <n>` of review.md has a `Reviewers:` line naming `10x:security-reviewer` and no mention of the fp outside its
// `Criteria:` line, `### Fixes applied` and `### Decisions`; else it is kept with the first failing condition. The record
// holds one line per candidate, `removed\t<fp>\t<n>`, `kept\t<fp>\t<why>` or `gone\t<fp>`. The board lists them under
// `## Security entries`, after `## Needs the human`, `## Host reruns` and `## Set aside` and before `## Hand checks
// pending`, absent when there is none, as `- <id> — removed <fp> (review.md
// round <n>)`, `- <id> — kept <fp>: <why>` or `- <id> — <fp> already gone`; a kept entry is also listed under
// `## Needs the human` as `- <id> — security entry kept <fp>: <why>`.
//
// Host reruns in a phase: a red record of the latest implement or close run fails the ticket with `host rerun red:
// <gate>: <last 10 lines of its log>`. A FAIL row of verify/summary.txt is excused when a green record's gate has its
// first 28 characters and its head starts with the summary's `tree: HEAD <short>`; an unexcused FAIL fails an implement
// ticket (`gate FAIL: <gate>`) unless a sandbox-red ask names it (its first 28 characters, trimmed), when the ticket
// waits on the asks. A close run that did not land with sandbox-red asks is `waiting`. A refused record of the latest
// run adds `host rerun refused: <gate> (<why>)` to a waiting ticket's evidence.
//
// Config (.claude/10x.json): `close`, `worktreeDir`, `batch.parallel` (implement runs at once, an integer ≥ 1,
// default 2), `batch.hostRerun` (true or false, default false; anything else exits 2), `gates`. Refusals print
// `10x-batch: <why>` and exit 2.

const { execFileSync, spawn, spawnSync } = require('node:child_process')
const { createHash, randomUUID } = require('node:crypto')
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const md = require(path.join(__dirname, '..', 'scripts', 'md-check.js'))
const roadmap = require(path.join(__dirname, '..', 'scripts', 'roadmap.js'))
const sec = require(path.join(__dirname, '..', 'scripts', 'security.js'))
const worktree = require(path.join(__dirname, '..', 'scripts', 'worktree.js'))

const ID = /^[A-Za-z0-9][A-Za-z0-9._-]*$/
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const KINDS = ['plan', 'reply', 'implement', 'close']
const HEADER = ['n', 'kind', 'session', 'session_kind', 'start', 'end', 'exit', 'pid']
const RUNNING = { plan: 'planning', implement: 'implementing', close: 'closing' }
const SETTLED = new Set(['landed', 'pr-open', 'failed', 'held', 'dropped'])
const USAGE =
  'usage: 10x-batch init [--auto] <ticket>... [--search "<query>"] | run <id> plan|reply|implement|close | status | drop <id> | replan <id> | approve <id>... | accept-green <id> <file> "<reason>" | checked <id> AC<n> "<what you saw>" | loop'
const APPROVE_REPLY = 'Approved. Set `Status: approved` in plan.md and stop; the implementation runs in a new session. Do not post `comment.md`: /10x:close carries it in the PR body.\n'
const FIXED_REPLY =
  "Auto mode: no human answers this batch's questions. A question the ticket's `Decisions` section answers is settled: take its answer, and neither ask it nor write it to `comment.md`. A question about security, or about a cost the batch would add — a paid service, or a real-model e2e beyond the configured gates — is not yours to answer: if you asked one, answer none of your questions, write the numbers of those questions, one per line, to `held-questions.md` in this ticket's `.10x/<id>/` directory, and stop. Answer every other question you asked with your own recommendation, product questions too — a question the ticket itself asks, what the user gets, the outcome of an edge case, what counts as done. Record each in plan.md under `## Auto decisions`, below `# Appendix`, one line per question: `- <its number> — <the choice and why>`, or `- (product) <its number> — <the choice and why>` for a product question. For a GitHub issue, also write the product answers to `comment.md` as /10x:work says; it is not posted now, /10x:close carries it in the PR body. Then go on.\n"
const SECURITY_FIXED_REPLY =
  "Auto mode: no human answers this batch's questions. A question the ticket's `Decisions` section answers is settled: take its answer, and neither ask it nor list it in `product-questions.md`. A question the ticket itself asks, and any product question — what the user gets, the outcome of an edge case, what counts as done — is a product question. A question about security, or about a cost the batch would add — a paid service, or a real-model e2e beyond the configured gates — counts as a product question here. If any question you asked is a product question, answer none of them: write their numbers, one per line, to `product-questions.md` in this ticket's `.10x/<id>/` directory, and stop. Otherwise answer every question with your own recommendation, record each in plan.md under `## Auto decisions`, below `# Appendix`, one line per question (its number, the choice and why), and go on.\n"
const PROCEED_REPLY =
  "Auto mode: no human answers this batch's questions. For each question you asked, take your recommended answer: append its `- Decided: <question> — <answer taken>; alternative: <each option not taken>` line to plan.md's `## Assumptions` as the work skill's Stop or proceed says, replace its asked line in evidence.md with the criterion's new state (remove a free `- asked:` line), and go on. A question about security, a cost the batch would add, a product decision or one only the user can settle is never answered this way: write its asked line again, starting with its mark, and stop.\n"
const FIXED_MAX = 3
const POLL_MS = 10000

const die = (msg) => {
  process.stderr.write(`10x-batch: ${msg}\n`)
  process.exit(2)
}

if (process.env.TENX_BATCH && ['init', 'run', 'drop', 'replan', 'approve', 'accept-green', 'checked', 'loop'].includes(process.argv[2])) die('refused inside a batch worker')

let common
try {
  common = execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-common-dir'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()
} catch {
  die('not in a git repository')
}
const ROOT = path.dirname(common)
const config = readConfig()
const CLOSE = config.close == null ? 'pr' : String(config.close)
const WT_DIR = path.join(ROOT, typeof config.worktreeDir === 'string' && config.worktreeDir ? config.worktreeDir : '.worktrees')
const PARALLEL = parallel()
const HOST_RERUN = hostRerun()
// The gates a sandbox-red report may name, matched exactly; an entry that is not a one-line string never matches.
const GATES = Array.isArray(config.gates) ? config.gates.filter((g) => typeof g === 'string' && !/[\t\n]/.test(g)) : []
const TENX_DIR = path.join(ROOT, '.10x')
const BATCH = path.join(TENX_DIR, '_batch')
const HOME = os.homedir()
const xdg = process.env.XDG_STATE_HOME
const S = canonical(path.join(xdg && path.isAbsolute(xdg) ? xdg : path.join(HOME, '.local', 'state'), '10x', createHash('sha256').update(fs.realpathSync(common)).digest('hex').slice(0, 16)))
const SB = path.join(S, 'batch')
const TICKETS = path.join(SB, 'tickets')
const MODE = path.join(SB, 'mode')
const BOARD = path.join(BATCH, 'board.md')
const VERSIONS = path.join(SB, 'versions')
const CLOSED = path.join(SB, 'versions.closed')
const ROADMAP = path.join(TENX_DIR, 'roadmap.md')
// What a worker's sandboxed Bash may write besides the working directory, and the settings that could widen it. Not
// ~/Library/pnpm (PNPM_HOME, on PATH): pnpm then uses a store in the temp dir (gh-27).
const ALLOW_WRITE = [os.tmpdir(), ...['.npm', 'Library/Caches', '.cache', 'Library/Developer'].map((x) => path.join(HOME, x)), '/dev/stdout', '/dev/fd']
// With CLAUDE_CONFIG_DIR set (empty included), Claude Code reads user settings there, resolved against its cwd: a
// worker's is ROOT.
const configDir = process.env.CLAUDE_CONFIG_DIR
const SETTINGS_FILES = [path.join(ROOT, '.claude'), path.join(HOME, '.claude'), ...(configDir === undefined ? [] : [path.resolve(ROOT, configDir)])]
  .flatMap((d) => [path.join(d, 'settings.json'), path.join(d, 'settings.local.json')])
// The 10x copy this script belongs to, which every worker loads with --plugin-dir.
const PLUGIN = canonical(path.join(__dirname, '..'))
// <p>'s real path; through a dangling symlink, at it or at an ancestor, the path the link names, as far as it resolves.
function real(p) {
  for (let hops = 0; hops < 40; hops++) {
    try {
      return canonical(p)
    } catch {
      // The deepest existing ancestor (or p itself) is a dangling link: follow it, keep the rest of the path.
      const rest = []
      let cur = p
      while (!fs.lstatSync(cur, { throwIfNoEntry: false })) {
        rest.unshift(path.basename(cur))
        cur = path.dirname(cur)
      }
      if (!fs.lstatSync(cur).isSymbolicLink()) return p
      p = path.join(path.resolve(path.dirname(cur), fs.readlinkSync(cur)), ...rest)
    }
  }
  return p
}
// What a process outside the sandbox later runs — git, a shell, a login agent, Claude Code's own config and plugins,
// this plugin's scripts and the main checkout's .claude/10x.json — from one table, as `edit` (paths for the Write and Edit rules, a directory as `<dir>/**`) and
// `sandbox` (the Bash sandbox's denyWrite, a directory as itself, no glob): real paths, plus the real path of any that
// is a symlink. zsh reads $HOME/.zshenv before ZDOTDIR is set; a relative ZDOTDIR or XDG_CONFIG_HOME is ignored. A path
// through a dangling symlink, at it or at an ancestor, is denied with the path the link names, as far as it resolves.
// The git common dir differs between the two: Edit gets all of it and `<worktree dir>/*/.git`, which covers the
// worktrees a run creates after it starts, since the Write tool never does git. The sandbox, where the worker's own git
// runs, gets only the files git runs code from (config, config.worktree, hooks, info/attributes) and commondir, which
// git reads in any git dir and follows to another config and hooks, plus the admin dir and the .git file (its `gitdir`,
// resolved against the admin dir) of every worktree registered now, except ticket <id>'s own, <worktree dir>/<id>; and the
// settings files, which run() denies Edit separately. Both get every pathDirs() directory, whose commands the user's
// shell runs, and the caches whose contents run later: npx's, pnpm dlx's and corepack's (and $COREPACK_HOME when
// absolute). No PATH entry contains an allowWrite path: checkPath() refuses one before any worker starts.
// Built by run() only.
function writeDeny(id) {
  const abs = (v) => (v && path.isAbsolute(v) ? real(v) : null)
  const home = canonical(HOME)
  const zdot = abs(process.env.ZDOTDIR) || home
  const xdgConfig = abs(process.env.XDG_CONFIG_HOME)
  const gitDir = fs.realpathSync(common)
  const claude = [home, ...(configDir === undefined ? [] : [path.resolve(ROOT, configDir)])]
  const files = [
    path.join(canonical(ROOT), '.envrc'),
    // Its setup runs outside the sandbox, and worktreeDir and close decide a later worker's denies. The ticket's own
    // worktree copy stays writable: it is content under review.
    path.join(canonical(ROOT), '.claude', '10x.json'),
    // zsh runs a newer <file>.zwc instead of <file>, and .zlogout when a login shell exits.
    ...['.zshrc', '.zshenv', '.zprofile', '.zlogin', '.zlogout'].flatMap((f) => [f, `${f}.zwc`]).map((f) => path.join(zdot, f)),
    ...['.zshenv', '.zshenv.zwc', '.bashrc', '.bash_profile', '.bash_login', '.bash_logout', '.profile', '.gitconfig', '.ssh/config'].map((f) => path.join(home, f)),
    ...claude.map((d) => path.join(d, '.claude.json')),
  ]
  const dirs = [
    path.join(home, '.config', 'git'),
    ...(xdgConfig ? [path.join(xdgConfig, 'git')] : []),
    ...['Library/LaunchAgents', '.config/systemd/user', '.config/autostart'].map((d) => path.join(home, d)),
    PLUGIN,
    path.join(home, '.claude', 'plugins'),
    path.join(home, '.claude', 'hooks'),
    ...claude.slice(1).flatMap((d) => [path.join(d, 'plugins'), path.join(d, 'hooks')]),
  ]
  const own = path.join(canonical(WT_DIR), id, '.git')
  const trees = []
  let entries = []
  try {
    entries = fs.readdirSync(path.join(gitDir, 'worktrees'), { withFileTypes: true }).filter((e) => e.isDirectory())
  } catch {}
  for (const e of entries) {
    const admin = path.join(gitDir, 'worktrees', e.name)
    // git writes gitdir relative to the admin dir under worktree.useRelativePaths.
    const raw = readOr(path.join(admin, 'gitdir'))?.trim()
    const gitFile = raw && real(path.resolve(admin, raw))
    if (gitFile === own) continue
    trees.push(admin, ...(gitFile ? [gitFile] : []))
  }
  const both = (ps) => ps.flatMap((p) => [p, real(p)])
  const ch = process.env.COREPACK_HOME
  const run = [
    ...pathDirs().map((e) => e.dir),
    ...['.npm/_npx', 'Library/Caches/pnpm/dlx', '.cache/node/corepack'].map((d) => path.join(home, d)),
    ...(ch && path.isAbsolute(ch) ? [path.resolve(ch)] : []),
  ]
  return {
    edit: [...new Set([...both(files), ...both([gitDir, ...dirs, ...run]).map((d) => `${d}/**`), `${canonical(WT_DIR)}/*/.git`])],
    sandbox: [
      ...new Set(both([...files, ...dirs, ...run, ...SETTINGS_FILES, ...['config', 'config.worktree', 'hooks', 'info/attributes', 'commondir'].map((f) => path.join(gitDir, f)), ...trees])),
    ],
  }
}
// The directories whose commands the user's shell runs: each non-empty absolute PATH entry, and PNPM_HOME when set and
// absolute, path.resolve()d, with the name a refusal gives it.
function pathDirs() {
  const ph = process.env.PNPM_HOME
  return [
    ...(process.env.PATH || '').split(path.delimiter).filter((e) => e && path.isAbsolute(e)).map((e) => ({ name: `PATH entry ${e}`, dir: path.resolve(e) })),
    ...(ph && path.isAbsolute(ph) ? [{ name: `PNPM_HOME ${ph}`, dir: path.resolve(ph) }] : []),
  ]
}
// Refuses a PATH entry or PNPM_HOME that is or contains the main checkout or an allowWrite path: denying it would deny
// what a worker must write, and leaving it writable would let a worker plant a command the user's shell runs.
function checkPath() {
  const roots = [ROOT, ...ALLOW_WRITE].map(canonical)
  for (const { name, dir } of pathDirs()) {
    const d = canonical(dir)
    for (const r of roots) {
      const rel = path.relative(d, r)
      if (rel === '' || (rel !== '..' && !rel.startsWith(`..${path.sep}`) && !path.isAbsolute(rel))) die(`${name} contains ${r}`)
    }
  }
}
// Claude Code's sandbox for ticket <id>'s worker, required; denyWrite is writeDeny(id)'s, read when its run starts.
const sandbox = (id) =>
  JSON.stringify({
    sandbox: {
      enabled: true,
      allowUnsandboxedCommands: false,
      failIfUnavailable: true,
      enableWeakerNetworkIsolation: true,
      filesystem: { allowWrite: ALLOW_WRITE, denyWrite: writeDeny(id).sandbox },
      network: { allowedDomains: ['*'], allowLocalBinding: true },
    },
  })
if (['init', 'run', 'drop', 'replan', 'approve', 'accept-green', 'loop'].includes(process.argv[2])) checkStateDir()
if (['run', 'replan'].includes(process.argv[2])) checkPath()
for (const p of [TENX_DIR, BATCH, S, SB]) if (fs.lstatSync(p, { throwIfNoEntry: false })?.isSymbolicLink()) die(`${p} is a symlink`)

const tdir = (id) => path.join(TENX_DIR, id)
const approval = (id) => path.join(S, `${id}.approved`)
// The comment authors of a gh-<n> ticket.md as init saw it, kept beside the approval records, out of a worker's reach.
const commenters = (id) => path.join(S, `${id}.commenters`)
const mkd = (d) => fs.mkdirSync(d, { recursive: true, mode: 0o700 })
// What the user approved: plan.md with its Status line blanked, so the worker's `Status: approved` keeps the hash.
const planHash = (text) => createHash('sha256').update(text.replace(/^Status:.*$/m, 'Status:')).digest('hex')
const bdir = (id) => {
  const d = path.join(BATCH, id)
  if (fs.lstatSync(d, { throwIfNoEntry: false })?.isSymbolicLink()) die(`${d} is a symlink`)
  return d
}
const sdir = (id) => {
  const d = path.join(SB, id)
  if (fs.lstatSync(d, { throwIfNoEntry: false })?.isSymbolicLink()) die(`${d} is a symlink`)
  return d
}
const rel = (p) => path.relative(ROOT, p)
const pad = (n) => String(n).padStart(2, '0')
const flat = (s) => String(s).replace(/[\r\n]+/g, ' ')

function readOr(f) {
  try {
    return fs.readFileSync(f, 'utf8')
  } catch {
    return null
  }
}

// The deepest existing ancestor of <p> through realpath, the rest appended, as in hooks/plan-boundary.js.
function canonical(p) {
  const rest = []
  let cur = p
  while (!fs.lstatSync(cur, { throwIfNoEntry: false })) {
    const up = path.dirname(cur)
    if (up === cur) break
    rest.unshift(path.basename(cur))
    cur = up
  }
  return path.join(fs.realpathSync(cur), ...rest)
}

// Refuses an S a worker could write: inside the main checkout, a worktree, the sandbox's allowWrite, or an allowWrite
// that a settings file merges into every worker's sandbox.
function checkStateDir() {
  const trees = (git(['worktree', 'list', '--porcelain']) || '').split('\n').filter((l) => l.startsWith('worktree ')).map((l) => l.slice(9))
  const extra = []
  for (const f of SETTINGS_FILES) {
    let a
    try {
      a = JSON.parse(fs.readFileSync(f, 'utf8'))?.sandbox?.filesystem?.allowWrite
    } catch {
      continue
    }
    if (!Array.isArray(a)) continue
    for (const p of a) if (typeof p === 'string' && p) extra.push(p === '~' || p.startsWith('~/') ? path.join(HOME, p.slice(1)) : path.resolve(ROOT, p))
  }
  for (const p of [ROOT, ...trees, ...ALLOW_WRITE, ...extra]) {
    const c = canonical(p)
    const r = path.relative(c, S)
    if (r === '' || (r !== '..' && !r.startsWith(`..${path.sep}`) && !path.isAbsolute(r))) die(`state dir ${S} is inside ${c}`)
  }
}

function readConfig() {
  const f = path.join(ROOT, '.claude', '10x.json')
  const text = readOr(f)
  if (text === null) return {}
  try {
    const c = JSON.parse(text)
    return c && typeof c === 'object' ? c : {}
  } catch (e) {
    die(`cannot read ${f}: ${e.message}`)
  }
}

function parallel() {
  const v = config.batch && typeof config.batch === 'object' ? config.batch.parallel : undefined
  if (v == null) return 2
  if (!Number.isInteger(v) || v < 1) die(`batch.parallel must be an integer ≥ 1, got ${JSON.stringify(v)}`)
  return v
}

function hostRerun() {
  const v = config.batch && typeof config.batch === 'object' ? config.batch.hostRerun : undefined
  if (v === undefined || v === false) return false
  if (v === true) return true
  die(`batch.hostRerun must be true or false, got ${JSON.stringify(v)}`)
}

// A fresh file renamed into place, so a concurrent reader never sees half of it; `wx` never follows a planted path.
function put(file, text) {
  const tmp = `${file}.${process.pid}.tmp`
  fs.writeFileSync(tmp, text, { flag: 'wx' })
  fs.renameSync(tmp, file)
}

// <env>, when given, is merged over process.env: accept-green passes worktree.pin's, which pins git to the checked worktree.
function git(argv, env) {
  try {
    return execFileSync('git', ['-C', ROOT, ...argv], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], env: env ? { ...process.env, ...env } : process.env }).trim()
  } catch {
    return null
  }
}

// ---------------------------------------------------------------- init

function init(argv) {
  const items = []
  let searched = false
  let auto = false
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--auto') auto = true
    else if (argv[i] !== '--search') items.push({ arg: argv[i] })
    else if (searched || i + 1 >= argv.length) die(USAGE)
    else {
      searched = true
      items.push({ search: argv[++i] })
    }
  }
  if (!items.length) die(USAGE)
  const ids = []
  const errors = []
  const versions = []
  const closed = []
  const add = (id) => ids.includes(id) || ids.push(id)
  for (const it of items) {
    if (it.search === undefined) {
      const r = resolve(it.arg)
      if (r.refused) {
        errors.push(r.refused)
        continue
      }
      const v = r.id || !ID.test(it.arg) || /^[0-9]+$/.test(it.arg) ? null : version(it.arg)
      if (r.id) add(r.id)
      else if (!v) errors.push(`no ticket: ${it.arg}${r.why ? ` (${flat(r.why)})` : ''}`)
      else if (v.why) errors.push(v.why)
      else {
        versions.includes(it.arg) || versions.push(it.arg)
        for (const id of v.ids) {
          if (fs.existsSync(path.join(tdir(id), 'landed'))) {
            closed.includes(id) || closed.push(id)
            continue
          }
          const m = roadmap.GH.test(id) ? id.slice(3) : null
          const s = m ? issueState(m) : {}
          if (s.why) errors.push(`no ticket: ${it.arg} → ${id} (${flat(s.why)})`)
          else if (s.state === 'CLOSED') closed.includes(id) || closed.push(id)
          else {
            const t = resolve(id)
            if (t.id) add(t.id)
            else if (t.refused) errors.push(t.refused)
            else errors.push(`no ticket: ${it.arg} → ${id}${t.why ? ` (${flat(t.why)})` : ''}`)
          }
        }
      }
      continue
    }
    const label = `--search ${JSON.stringify(it.search)}`
    const s = search(it.search)
    if (s.why) {
      errors.push(`no ticket: ${label} (${flat(s.why)})`)
      continue
    }
    for (const n of s.numbers) {
      const r = fetchGh(n)
      if (r.id) add(r.id)
      else if (r.refused) errors.push(r.refused)
      else errors.push(`no ticket: ${label} → #${n} (${flat(r.why)})`)
    }
  }
  if (errors.length) {
    for (const e of errors) process.stderr.write(`10x-batch: ${e}\n`)
    process.exit(2)
  }
  // A ticket named directly is batched again, never also counted as landed.
  for (let k = closed.length - 1; k >= 0; k--) if (ids.includes(closed[k])) closed.splice(k, 1)
  // Its workers may still be running, and only the previous version knows where its records are.
  if (fs.existsSync(path.join(BATCH, 'tickets')) && !fs.existsSync(TICKETS))
    die(`${rel(BATCH)} is a batch from before the state dir; finish it with the previous version, or move it away`)
  if (fs.existsSync(BATCH) && fs.existsSync(TICKETS)) {
    const open = deriveAll(readIds()).filter((r) => !SETTLED.has(r.phase))
    if (open.length) die(`the batch in ${rel(BATCH)} has unsettled tickets: ${open.map((r) => `${r.id} (${r.phase})`).join(', ')}`)
  }
  if (fs.existsSync(BATCH) || fs.existsSync(SB)) archive()
  // A ticket batched again needs a new approval.
  for (const id of ids) {
    fs.rmSync(approval(id), { force: true })
    fs.rmSync(commenters(id), { force: true })
    const logins = roadmap.GH.test(id) ? ticketCommenters(id) : null
    if (logins) {
      mkd(S)
      put(commenters(id), logins.map((l) => l + '\n').join(''))
    }
  }
  mkd(SB)
  for (const id of ids) {
    fs.mkdirSync(bdir(id), { recursive: true })
    mkd(sdir(id))
  }
  put(MODE, `${auto ? 'auto' : 'default'}\n`)
  put(TICKETS, ids.join('\n') + '\n')
  if (versions.length) put(VERSIONS, versions.join('\n') + '\n')
  if (closed.length) put(CLOSED, closed.join('\n') + '\n')
  report(deriveAll(ids))
}

// The ticket ids of roadmap version <v>, { why } for a version that cannot be batched, or null when the roadmap has no
// such version.
function version(v) {
  const text = readOr(ROADMAP)
  if (text === null) return null
  const p = roadmap.parse(text, roadmap.ticketTest(TENX_DIR))
  const row = p.rows.find((r) => r.version === v)
  if (!row) return null
  if (p.faults.length) return { why: `no ticket: ${v} (${rel(ROADMAP)}:${p.faults[0].line}: ${p.faults[0].why})` }
  if (!row.ids.length) return { why: `version ${v} has no ticket ids: run /10x:roadmap tickets ${v}` }
  return { ids: row.ids }
}

// The state gh reports for issue <n> of origin's repo: { state } or { why }.
function issueState(n) {
  const o = originRepo()
  if (o.why) return o
  const r = spawnSync('gh', ['issue', 'view', n, '--repo', `github.com/${o.repo}`, '--json', 'state'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
  if (r.error) return { why: r.error.code === 'ENOENT' ? '`gh` is not installed' : r.error.message }
  if (r.status !== 0) return { why: (r.stderr || 'gh failed').trim() }
  try {
    return { state: String(JSON.parse(r.stdout).state) }
  } catch {
    return { why: `gh answered with something other than JSON: ${r.stdout.trim().slice(0, 200)}` }
  }
}

function resolve(a) {
  let m
  if ((m = /^(?:#|gh-)?([1-9][0-9]*)$/.exec(a))) return fetchGh(m[1])
  if ((m = /^https:\/\/github\.com\/([A-Za-z0-9._-]+\/[A-Za-z0-9._-]+)\/issues\/([1-9][0-9]*)\/?$/.exec(a))) {
    const o = originRepo()
    if (o.why) return o
    if (m[1].toLowerCase() !== o.repo.toLowerCase()) return { why: `not an issue of origin's repo ${o.repo}` }
    return fetchGh(m[2])
  }
  if (!ID.test(a)) return { why: 'neither a ticket id, an issue number nor an issue URL' }
  if (!fs.existsSync(path.join(tdir(a), 'ticket.md'))) return { why: `no ${rel(path.join(tdir(a), 'ticket.md'))}` }
  return { id: a }
}

// gh-<n>, its ticket.md written by 10x-ticket every time, so init records commenters from the issue and never from a
// file an earlier batch's worker may have edited; { refused } when the issue is not the user's. An existing ticket.md
// is checked before it is fetched again, so a stranger's issue leaves it untouched.
function fetchGh(n) {
  const id = `gh-${n}`
  const ticket = path.join(tdir(id), 'ticket.md')
  const kept = fs.existsSync(ticket)
  if (kept) {
    const refused = owner(n)
    if (refused) return { refused }
  }
  const existed = fs.existsSync(tdir(id))
  const step = (bin, argv) => {
    const r = spawnSync(path.join(__dirname, bin), argv, { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
    return r.status === 0 ? null : (r.stderr || r.stdout || `${bin} failed`).trim() || `${bin} failed`
  }
  const why = step('10x-worktree', ['init', id]) || step('10x-ticket', ['github', n, '--out', ticket])
  if (kept) return why ? { why } : { id }
  const refused = why ? null : owner(n)
  if (!why && !refused) return { id }
  if (!existed) fs.rmSync(tdir(id), { recursive: true, force: true })
  return why ? { why } : { refused }
}

let login = null
// null when issue <n> of origin's repo was written by the `gh` login, else the refusal line: a batch worker acts on
// its ticket's text unattended, so a stranger's issue could steer it. The login comes from `gh api user --jq .login`,
// once per process, the author from `gh issue view <n> --json author`; they compare case-insensitively.
const ghRun = (argv) => {
  const r = spawnSync('gh', argv, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
  if (r.error) return { why: r.error.code === 'ENOENT' ? '`gh` is not installed' : r.error.message }
  if (r.status !== 0) return { why: (r.stderr || 'gh failed').trim() }
  return { out: r.stdout.trim() }
}

function owner(n) {
  const cannot = (why) => `cannot check the author of gh-${n}: ${flat(why)}`
  const o = originRepo()
  if (o.why) return cannot(o.why)
  if (login === null) {
    const u = ghRun(['api', 'user', '--jq', '.login'])
    if (u.why) return cannot(u.why)
    if (!u.out) return cannot('gh api user printed no login')
    login = u.out
  }
  const v = ghRun(['issue', 'view', n, '--repo', `github.com/${o.repo}`, '--json', 'author'])
  if (v.why) return cannot(v.why)
  let author
  try {
    author = JSON.parse(v.out).author
  } catch {
    return cannot(`gh answered with something other than JSON: ${v.out.slice(0, 200)}`)
  }
  const who = author && typeof author.login === 'string' && author.login ? author.login : null
  if (who && who.toLowerCase() === login.toLowerCase()) return null
  return `not your issue: gh-${n} (author ${who || 'unknown'})`
}

// The comment authors 10x-ticket wrote under `## Comments` in ticket <id>'s ticket.md, lowercased; null when the file
// is missing or the section has no author line.
function ticketCommenters(id) {
  const text = readOr(path.join(tdir(id), 'ticket.md'))
  if (text === null) return null
  const lines = text.split('\n')
  const at = lines.indexOf('## Comments')
  if (at === -1) return []
  const read = lines.slice(at + 1).map((l) => /^\*\*(.+)\*\* \([0-9]{4}-[0-9]{2}-[0-9]{2}\):$/.exec(l)).filter(Boolean)
  return read.length ? read.map((m) => m[1].toLowerCase()) : null
}

// True when a comment on issue <n> is by someone other than the issue's author, or when that cannot be told: ticket.md
// carries every comment, so auto mode leaves such a plan for the human to approve. Both the issue as it is now and the
// authors init recorded from the ticket.md the worker read are checked, so a comment deleted after `init`, or dropped
// from ticket.md by the worker, still counts; no record holds the plan.
function strangerComments(n) {
  const o = originRepo()
  if (o.why) return true
  const v = ghRun(['issue', 'view', n, '--repo', `github.com/${o.repo}`, '--json', 'author,comments'])
  if (v.why) return true
  let who, logins
  try {
    const { author, comments } = JSON.parse(v.out)
    who = author?.login
    if (typeof who !== 'string' || !who || !Array.isArray(comments)) return true
    logins = comments.map((c) => c?.author?.login)
  } catch {
    return true
  }
  const seen = readOr(commenters(`gh-${n}`))
  if (seen === null) return true
  logins.push(...seen.split('\n').filter(Boolean))
  return logins.some((l) => typeof l !== 'string' || l.toLowerCase() !== who.toLowerCase())
}

function search(q) {
  const o = originRepo()
  if (o.why) return o
  const r = spawnSync('gh', ['issue', 'list', '--repo', `github.com/${o.repo}`, '--state', 'open', '--search', q, '--json', 'number', '--limit', '100'], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  })
  if (r.error) return { why: r.error.code === 'ENOENT' ? '`gh` is not installed' : r.error.message }
  if (r.status !== 0) return { why: (r.stderr || 'gh failed').trim() }
  let numbers
  try {
    numbers = JSON.parse(r.stdout).map((i) => String(i.number))
  } catch {
    return { why: `gh answered with something other than a JSON list: ${r.stdout.trim().slice(0, 200)}` }
  }
  numbers = numbers.filter((n) => /^[1-9][0-9]*$/.test(n))
  return numbers.length ? { numbers } : { why: 'no open issue matches' }
}

// OWNER/REPO of origin on github.com, derived as 10x-ticket derives it.
function originRepo() {
  let url = git(['remote', 'get-url', 'origin'])
  if (url === null) return { why: 'no origin remote' }
  url = url.replace(/\/$/, '').replace(/\.git$/, '')
  let host = ''
  let p = ''
  const scheme = /^[^:/]+:\/\/([^/]*)\/(.*)$/.exec(url)
  const scp = /^(?:[^/:]+@)?([^/:]+):(.+)$/.exec(url)
  if (scheme) [host, p] = [scheme[1].replace(/^.*@/, '').replace(/:.*$/, ''), scheme[2]]
  else if (scp) [host, p] = [scp[1], scp[2]]
  if (host !== 'github.com') return { why: `needs a github.com origin, got '${url}'` }
  const repo = p.split('/').slice(-2).join('/')
  if (!/^[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+$/.test(repo)) return { why: 'cannot derive OWNER/REPO from origin' }
  return { repo }
}

const today = (d = new Date()) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`

function archive() {
  const d = new Date()
  const stamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`
  let s = stamp
  for (let k = 2; fs.existsSync(`${BATCH}.${s}`) || fs.existsSync(`${SB}.${s}`); k++) s = `${stamp}-${k}`
  for (const d of [BATCH, SB]) if (fs.existsSync(d)) fs.renameSync(d, `${d}.${s}`)
}

// ---------------------------------------------------------------- records and phases

const mode = () => ((readOr(MODE) || '').trim() === 'auto' ? 'auto' : 'default')

function readIds() {
  const text = readOr(TICKETS)
  if (text === null) die('no batch: run `10x-batch init <tickets>` first')
  return text
    .split('\n')
    .map((s) => s.trim())
    .filter((s) => ID.test(s))
}

function runs(id) {
  const text = readOr(path.join(sdir(id), 'runs.tsv'))
  if (text === null) return []
  return text
    .split('\n')
    .slice(1)
    .filter(Boolean)
    .map((l) => {
      const c = l.split('\t')
      return Object.fromEntries(HEADER.map((h, i) => [h, c[i] ?? '']))
    })
}

function writeRuns(id, rows) {
  put(path.join(sdir(id), 'runs.tsv'), [HEADER, ...rows.map((r) => HEADER.map((h) => r[h]))].map((c) => c.join('\t') + '\n').join(''))
}

function alive(pid) {
  const n = Number(pid)
  if (!Number.isInteger(n) || n <= 0) return false
  try {
    process.kill(n, 0)
    return true
  } catch {
    return false
  }
}

// The run's worker, not a pid runs.tsv was made to name: a live process whose arguments hold the run's session uuid
// right after --session-id or --resume.
function ours(r) {
  if (!alive(r.pid) || !UUID.test(r.session)) return false
  const ps = spawnSync('ps', ['-o', 'command=', '-p', String(Number(r.pid))], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  const args = ps.status === 0 ? ps.stdout.trim().split(/\s+/) : []
  return args.some((a, k) => (a === '--session-id' || a === '--resume') && args[k + 1] === r.session)
}

const isOpen = (r) => r.end === '' && r.exit === ''

// The shared path of two `## Files` lists: equal, or one a directory (`…/`) holding the other. A `CHANGELOG*` file
// is not counted: `10x-land rebase` merges its conflicts.
const notChangelog = (x) => x.endsWith('/') || !path.basename(x).startsWith('CHANGELOG')
function overlap(a, b) {
  for (const x of a.filter(notChangelog))
    for (const y of b.filter(notChangelog)) {
      if (x === y || (x.endsWith('/') && y.startsWith(x))) return x
      if (y.endsWith('/') && x.startsWith(y)) return y
    }
  return null
}

// A ticket failed, or waiting on the user (a plan or an implement session) for over 30 minutes since its latest run, is
// set aside: it holds no batch.parallel slot, no Files and no later close.
const SET_ASIDE_MS = 30 * 60 * 1000

function deriveAll(ids) {
  const now = Date.now()
  const rows = ids.map((id) => {
    const r = derive(id)
    const t = Number(r.last?.end || r.last?.start) || 0
    r.waited = t ? Math.max(0, now - t) : 0
    r.setAside = r.phase === 'failed' || (r.phase === 'waiting' && ['plan', 'implement'].includes(r.last.session_kind) && r.waited > SET_ASIDE_MS)
    return r
  })
  // An approved ticket whose files a later ticket already holds — implemented, not landed nor set aside — waits for it
  // to land.
  rows.forEach((r, i) => {
    if (r.phase !== 'approved' || r.implemented) return
    for (const e of rows.slice(i + 1)) {
      if (!e.implemented || e.setAside || ['landed', 'pr-open', 'dropped'].includes(e.phase)) continue
      const p = overlap(r.files, e.files)
      if (p) {
        Object.assign(r, { phase: 'held', evidence: `shares ${p} with ${e.id} (${e.phase}), which implemented first` })
        break
      }
    }
  })
  // An approved relock changed a locked test: shown in every phase but dropped.
  for (const r of rows) {
    r.relocked = r.phase === 'dropped' ? [] : relocks(r.id)
    if (r.relocked.length) r.evidence = [r.evidence, ...r.relocked.map((x) => `relocked: ${x}`)].filter(Boolean).join('; ')
  }
  // A question an implementation session proceeded on with its recommendation: listed for the user, never waited on.
  for (const r of rows) r.decided = r.phase === 'dropped' ? [] : decisions(readOr(path.join(tdir(r.id), 'plan.md')))
  // `loop` approved the plan, not the user: shown first in every phase but dropped.
  for (const r of rows) {
    const hash = r.phase === 'dropped' ? '' : (readOr(path.join(sdir(r.id), 'auto-approved')) || '').trim()
    if (hash) r.evidence = [`auto-approved (sha256 ${hash.slice(0, 12)})`, r.evidence].filter(Boolean).join('; ')
  }
  // The latest run fell back from auto mode: the mode it ran in, unless it never started for want of its sandbox.
  for (const r of rows) {
    const mode = r.last && !r.sandbox ? (readOr(path.join(bdir(r.id), `${pad(r.last.n)}-fallback`)) || '').trim() : ''
    if (mode) r.evidence = [r.evidence, `auto mode unavailable: ran in ${mode}`].filter(Boolean).join('; ')
  }
  return rows
}

function derive(id) {
  const rs = runs(id)
  const last = rs[rs.length - 1]
  const planText = readOr(path.join(tdir(id), 'plan.md'))
  const turn = path.join(bdir(id), 'turn.md')
  const row = {
    id,
    last,
    session: last ? last.session : '',
    files: planText ? md.files(planText) : [],
    implemented: rs.some((r) => r.session_kind === 'implement'),
    approvable: false,
  }
  const set = (phase, evidence = fs.existsSync(turn) ? rel(turn) : '') =>
    Object.assign(row, { phase, evidence: row.denied ? [evidence, row.denied].filter(Boolean).join('; ') : evidence })
  if (fs.existsSync(path.join(sdir(id), 'dropped'))) return set('dropped', 'dropped by the user')
  if (!last) return set('queued', '')
  // A gate of its latest session's report rerunning on the host: the session is still at work.
  if (alive((readOr(path.join(sdir(id), 'rerun')) || '').trim())) return set(RUNNING[last.session_kind] || 'planning')
  const open = isOpen(last)
  if (open && alive(last.pid)) return set(RUNNING[last.session_kind] || 'planning')
  const exit = open ? '?' : last.exit
  const tag = `run ${pad(last.n)} (${last.kind})`
  const denied = (readOr(path.join(bdir(id), `${pad(last.n)}-denials.tsv`)) || '').split('\n').filter(Boolean)
  if (denied.length) row.denied = `${denied.length} denied (see ${rel(path.join(bdir(id), `${pad(last.n)}-denials.tsv`))})`
  if ((readOr(path.join(bdir(id), `${pad(last.n)}-sandbox`)) || '').trim() === 'unavailable') {
    row.sandbox = true
    return set('failed', 'sandbox unavailable')
  }
  if ((readOr(path.join(bdir(id), `${pad(last.n)}-plugin`)) || '').trim() === 'missing') return set('failed', '10x plugin missing')
  const rebase = (readOr(path.join(bdir(id), `${pad(last.n)}-rebase`)) || '').trim()
  if (rebase) return set('failed', rebase)
  if (exit !== '0') return set('failed', exit === '?' ? `${tag} ended without an exit code` : `${tag} exited ${exit}`)
  const rr = ['implement', 'close'].includes(last.session_kind) ? reruns(id).filter((x) => x.run === last.n) : []
  const red = rr.find((x) => x.result === 'red')
  if (red) return set('failed', `host rerun red: ${flat(red.gate)}: ${flat(tail(red.log, 10, id).join(' '))}`)
  const refusedRr = rr.filter((x) => x.result.startsWith('refused: ')).map((x) => `host rerun refused: ${x.gate} (${x.result.slice(9)})`)

  if (last.session_kind === 'plan') {
    if (planText && /^Status:\s*approved\s*$/m.test(planText)) {
      if ((readOr(approval(id)) || '').trim() === planHash(planText)) return set('approved')
      return set('failed', `plan.md says approved, but no approval of yours matches it (10x-batch approve ${id})`)
    }
    row.approvable = !!planText && /^Status:\s*draft\s*$/m.test(planText) && planCheck(id)
    return set('waiting')
  }
  if (last.session_kind === 'implement') {
    // A FAIL the worker reported sandbox-red leaves the ticket waiting on that ask, below.
    const named = sandboxAsks(id).map((g) => g.slice(0, 28).trim())
    const gate = failedGates(id).find((g) => !named.includes(g))
    if (gate) return set('failed', `gate FAIL: ${gate}`)
    const ev = evidence(id, planText)
    if (ev.open && !ev.asked) {
      if (!denied.length) return set('failed', `open criterion: ${ev.open}`)
      return set('waiting', [`open criterion: ${ev.open}`, fs.existsSync(turn) ? rel(turn) : ''].filter(Boolean).join('; '))
    }
    if (ev.asked) return set('waiting', [...ev.asks, ...refusedRr, fs.existsSync(turn) ? rel(turn) : ''].filter(Boolean).join('; '))
    return set('implemented')
  }
  if (last.session_kind === 'close') {
    if (!fs.existsSync(path.join(WT_DIR, id))) return set('landed', (readOr(path.join(bdir(id), `${pad(last.n)}-landed`)) || '').trim() || landedOn())
    const url = CLOSE === 'pr' ? prOpen(id) : null
    if (url) return set('pr-open', url)
    const asks = sandboxAsks(id)
    if (asks.length)
      return set('waiting', [...asks.map((g) => `sandbox-red: ${g}`), ...refusedRr, `close did not land${fs.existsSync(turn) ? `; see ${rel(turn)}` : ''}`].join('; '))
    return set(denied.length ? 'waiting' : 'failed', `close did not land${fs.existsSync(turn) ? `; see ${rel(turn)}` : ''}`)
  }
  return set('failed', `${tag} has an unknown session kind '${last.session_kind}'`)
}

function planCheck(id) {
  return spawnSync(path.join(__dirname, '10x-plan-check'), [id], { cwd: ROOT, stdio: 'ignore' }).status === 0
}

// Every gate whose result column is FAIL in verify/summary.txt, except one a green host rerun covers: its first 28
// characters match and its head starts with the summary's `tree: HEAD <short>` (a MOVED summary has none). Log tail
// lines are indented and skipped.
function failedGates(id) {
  const text = readOr(path.join(tdir(id), 'verify', 'summary.txt')) || ''
  const at = /^tree: HEAD ([0-9a-f]+),/m.exec(text)?.[1]
  const green = at ? reruns(id).filter((x) => x.result === 'green' && x.head.startsWith(at)).map((x) => x.gate.slice(0, 28).trim()) : []
  const out = []
  for (const l of text.split('\n')) {
    if (/^\s/.test(l) || l.length < 34) continue
    const g = l.slice(0, 28).trim()
    if (/^FAIL\s/.test(l.slice(29)) && !green.includes(g)) out.push(g)
  }
  return out
}

// The gates of ticket <id>'s free `- asked: sandbox-red: <gate>` lines, in order, once each.
function sandboxAsks(id) {
  const gates = evidenceLines(id).asks.filter((a) => a.startsWith('sandbox-red:')).map((a) => a.slice(12).trim())
  return [...new Set(gates.filter(Boolean))]
}

const RERUN_HEADER = ['run', 'gate', 'head', 'result', 'exit', 'log']
// S/batch/<id>/reruns.tsv: one record per reported gate the conductor handled.
function reruns(id) {
  const text = readOr(path.join(sdir(id), 'reruns.tsv'))
  if (text === null) return []
  return text
    .split('\n')
    .slice(1)
    .filter(Boolean)
    .map((l) => {
      const c = l.split('\t')
      return Object.fromEntries(RERUN_HEADER.map((h, i) => [h, c[i] ?? '']))
    })
}

// The last <n> lines of ticket <id>'s rerun log <name> (a bare `<nn>-rerun-<k>.log`), else none.
function tail(name, n, id) {
  if (!/^[0-9]+-rerun-[0-9]+\.log$/.test(name)) return []
  const lines = (readOr(path.join(BATCH, id, name)) || '').split('\n')
  if (lines.at(-1) === '') lines.pop()
  return lines.slice(-n)
}

// A sha shortened as `git rev-parse --short` does in the main checkout.
const short = (sha) => (/^[0-9a-f]{40,64}$/.test(sha) && git(['rev-parse', '--short', sha])) || sha.slice(0, 7)

// The last state of each criterion in ticket <id>'s evidence.md, outside fences, and the texts of its free asked lines.
function evidenceLines(id) {
  const raw = (readOr(path.join(tdir(id), 'evidence.md')) || '').split('\n')
  const outside = md.blank(raw, 0)
  const state = new Map()
  const asks = []
  raw.forEach((line, k) => {
    if (outside[k] === null) return
    const ac = /^\s*[-*+]\s+(AC\d+)\s*[—–:-]\s*(.*?)\s*$/.exec(line)
    if (ac) state.set(ac[1], ac[2])
    else if (/^\s*[-*+]\s+asked:\s*\S/.test(line)) asks.push(line.replace(/^\s*[-*+]\s+asked:\s*/, '').trim())
  })
  return { state, asks }
}

// The first criterion of the plan that evidence.md leaves neither met, deferred, a declared hand-check nor asked, and
// the texts of its asked lines; the last line for a criterion wins, as in hooks/stop-gate.js.
function evidence(id, planText) {
  const crit = planText ? md.criteria(planText).map((c) => `AC${c.n}`) : []
  const hand = planText ? md.handChecks(planText) : []
  const { state, asks } = evidenceLines(id)
  let open = null
  for (const ac of crit) {
    const v = state.get(ac)
    if (v === undefined) open ??= `${ac} has no line`
    else if (/^asked:/.test(v)) asks.push(v.replace(/^asked:\s*/, ''))
    else if (!/^(met|deferred):\s*\S/.test(v) && !(hand.includes(ac) && /^hand-check:\s*\S/.test(v))) open ??= `${ac} — ${v}`
  }
  return { open, asked: asks.length > 0, asks }
}

// The criteria of ticket <id>'s plan, declared hand checks, whose last evidence.md line is `hand-check:`, in the plan's
// order: [{ ac, text }], <text> what follows `hand-check:`.
function handPending(id) {
  const planText = readOr(path.join(tdir(id), 'plan.md'))
  if (planText === null) return []
  const hand = md.handChecks(planText)
  const { state } = evidenceLines(id)
  const out = []
  for (const c of md.criteria(planText)) {
    const ac = `AC${c.n}`
    const v = state.get(ac)
    if (hand.includes(ac) && v !== undefined && /^hand-check:\s*\S/.test(v)) out.push({ ac, text: v.replace(/^hand-check:\s*/, '') })
  }
  return out
}

// The reasons of relock.md's approved entries (`## Relock <n>` with a `reason` and an `approved` ruling), in order.
function relocks(id) {
  const raw = (readOr(path.join(tdir(id), 'relock.md')) || '').split('\n')
  const outside = md.blank(raw, 0)
  const entries = []
  raw.forEach((line, k) => {
    if (outside[k] === null) return
    if (/^##\s+Relock\b/.test(line)) entries.push({})
    const m = /^\s*[-*+]\s+(reason|ruling):\s*(.*?)\s*$/.exec(line)
    if (m && entries.length) entries[entries.length - 1][m[1]] = m[2]
  })
  return entries.filter((e) => e.reason && /^approved\s*[—:-]/i.test(e.ruling || '')).map((e) => e.reason)
}

// The texts after `Decided:` of the top-level bullets under a plan's `## Assumptions`, outside fences, in order: the
// questions an implementation session proceeded on with its own recommendation.
function decisions(planText) {
  if (!planText) return []
  const lines = planText.split('\n'), b = md.blank(lines)
  const out = []
  for (const sec of md.sections(planText).filter((s) => s.name.toLowerCase() === 'assumptions'))
    for (let k = sec.from; k < sec.to; k++) {
      const m = b[k] !== null && /^[-*+]\s+Decided:\s*(\S.*)$/.exec(lines[k])
      if (m) out.push(flat(m[1].trim()))
    }
  return out
}

// The base branch name: config `base`, else develop if origin has it, else origin's default, else main.
function baseBranch() {
  if (typeof config.base === 'string' && config.base) return config.base
  if (git(['show-ref', '--verify', '--quiet', 'refs/remotes/origin/develop']) !== null) return 'develop'
  return (git(['symbolic-ref', '--quiet', '--short', 'refs/remotes/origin/HEAD']) || '').replace(/^origin\//, '') || 'main'
}

// The ref base_ref in scripts/lib.sh picks: origin/<base> when origin has it, unless `close: local` and the local base
// contains it; else the local base.
function baseRef() {
  const b = baseBranch()
  if (git(['show-ref', '--verify', '--quiet', `refs/remotes/origin/${b}`]) === null) return b
  if (CLOSE === 'local' && git(['merge-base', '--is-ancestor', `refs/remotes/origin/${b}`, `refs/heads/${b}`]) !== null) return b
  return `origin/${b}`
}

function landedOn() {
  const base = baseBranch()
  const remote = git(['show-ref', '--verify', '--quiet', `refs/remotes/origin/${base}`]) !== null
  const ref = remote && CLOSE !== 'local' ? `refs/remotes/origin/${base}` : `refs/heads/${base}`
  const sha = git(['rev-parse', '--short', ref])
  return sha ? `landed on ${base} at ${sha}` : `landed (worktree removed)`
}

// The PR url when `10x-land check <id>` prints `pr: OPEN <url>`; only that line is read.
function prOpen(id) {
  const r = spawnSync(path.join(__dirname, '10x-land'), ['check', id], { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  const m = /^pr: OPEN (\S+)$/m.exec(r.stdout || '')
  return m ? m[1] : null
}

// ---------------------------------------------------------------- schedule

// Why ticket <i> cannot implement now, or null: an earlier unsettled ticket whose `## Files` are not known yet, or a
// shared path with a running ticket or an earlier one that has not landed; a set-aside ticket blocks neither way.
function implementBlock(rows, i) {
  const r = rows[i]
  const unknown = rows.slice(0, i).find((e) => !SETTLED.has(e.phase) && !e.setAside && !e.files.length)
  if (unknown) return `${unknown.id} (${unknown.phase}) has no plan with ## Files yet`
  for (const [j, e] of rows.entries()) {
    if (j === i) continue
    const busy = !e.setAside && (Object.values(RUNNING).includes(e.phase) || (j < i && !['landed', 'pr-open', 'dropped'].includes(e.phase)))
    const p = busy && overlap(r.files, e.files)
    if (p) return `${r.id} shares ${p} with ${e.id} (${e.phase})`
  }
  return null
}

function actions(rows) {
  const out = []
  const planning = rows.some((r) => r.phase === 'planning')
  for (const r of rows) if (r.phase === 'queued') out.push(`plan ${r.id}`)
  for (const r of rows)
    if (r.phase === 'waiting' && (r.last.session_kind !== 'plan' || !planning)) out.push(`answer ${r.id}${r.approvable ? ' approvable' : ''}`)
  let slots = PARALLEL - implementing(rows).length
  rows.forEach((r, i) => {
    if (r.phase !== 'approved' || slots <= 0 || implementBlock(rows, i)) return
    out.push(`implement ${r.id}`)
    slots--
  })
  const c = closeCandidate(rows)
  if (c) out.push(`close ${c.id}`)
  if (rows.every((r) => SETTLED.has(r.phase))) out.push('done')
  return out
}

// The tickets holding a batch.parallel slot: implementing, or waiting on a question of their implement session and not
// set aside.
const implementing = (rows) => rows.filter((r) => r.phase === 'implementing' || (r.phase === 'waiting' && r.last.session_kind === 'implement' && !r.setAside))

function closeCandidate(rows) {
  if (rows.some((r) => r.phase === 'closing')) return null
  const i = rows.findIndex((r) => r.phase === 'implemented')
  return i >= 0 && rows.slice(0, i).every((r) => SETTLED.has(r.phase) || r.setAside) ? rows[i] : null
}

// Why `status` does not list <kind> for ticket <i>.
function refusal(rows, i, kind) {
  const r = rows[i]
  const want = { plan: 'queued', implement: 'approved', close: 'implemented' }[kind]
  if (r.phase !== want) return `${kind} ${r.id} refused: ${r.id} is ${r.phase}, not ${want}`
  if (kind === 'implement') {
    const open = implementing(rows).map((e) => `${e.id} (${e.phase})`)
    if (open.length >= PARALLEL) return `implement ${r.id} refused: batch.parallel is ${PARALLEL} and ${open.join(', ')} ${open.length > 1 ? 'hold' : 'holds'} the slots`
    const why = implementBlock(rows, i)
    if (why) return `implement ${r.id} refused: ${why}`
    return `implement ${r.id} refused: earlier approved tickets take the batch.parallel (${PARALLEL}) slots`
  }
  if (kind === 'close') {
    const closing = rows.find((e) => e.phase === 'closing')
    if (closing) return `close ${r.id} refused: ${closing.id} is closing`
    const early = rows.slice(0, i).find((e) => !SETTLED.has(e.phase) && !e.setAside)
    if (early) return `close ${r.id} refused: the earlier ticket ${early.id} is ${early.phase}`
  }
  return `${kind} ${r.id} refused`
}

// ---------------------------------------------------------------- security entries of a landed ticket

const FPS = /sha256:[0-9a-f]{64}/g

// Settles the security entries of every landed ticket once: the claim is S/batch/<id>/security, created exclusively, so
// a concurrent `run` or `loop` that loses the race skips the ticket.
function settleSecurity(rows) {
  for (const r of rows) {
    if (r.phase !== 'landed') continue
    const rec = path.join(sdir(r.id), 'security')
    if (fs.lstatSync(rec, { throwIfNoEntry: false })) continue
    mkd(sdir(r.id))
    try {
      fs.writeFileSync(rec, 'claimed\n', { flag: 'wx' })
    } catch {
      continue
    }
    put(rec, settle(r.id).map((x) => x.join('\t') + '\n').join(''))
  }
}

// One record line per candidate of ticket <id>: ['removed', fp, n], ['kept', fp, why] or ['gone', fp].
function settle(id) {
  const s = sec.load(TENX_DIR)
  const why = s.refusal || (s.faults.length ? `${rel(s.file)}:${s.faults[0].line}: ${s.faults[0].why}` : null)
  const cands = securityCandidates(id, why ? [] : s.entries)
  const clean = (t) => flat(t).replace(/\t/g, ' ')
  if (why) return cands.map((c) => ['kept', c.fp, `security.md cannot be read: ${clean(why)}`])
  const round = lastRound(id)
  return cands.map(({ fp, own }) => {
    if (!own) return ['kept', fp, "not the ticket's own"]
    const e = s.entries.find((x) => x.fp === fp)
    if (!e) return ['gone', fp]
    const found = e.values['found in']
    if (found !== id && !sec.AUDIT.test(found)) return ['kept', fp, `found in ${clean(found)} is neither ${id} nor an audit run`]
    if (!round) return ['kept', fp, 'review.md has no review round']
    if (!round.security) return ['kept', fp, `review.md round ${round.n} ran no security reviewer`]
    if (round.text.includes(fp)) return ['kept', fp, `review.md round ${round.n} has a finding against it`]
    const env = { ...process.env }
    delete env.TENX_BATCH
    const x = spawnSync(path.join(__dirname, '10x-security'), ['remove', found, fp], { cwd: ROOT, env, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
    if (x.status === 0) return ['removed', fp, round.n]
    const last = (x.stderr || '').split('\n').filter((l) => l.trim()).pop() || `exit ${x.status ?? x.error?.message}`
    return ['kept', fp, `10x-security remove failed: ${clean(last.replace(/^10x-security: /, ''))}`]
  })
}

// The fingerprints ticket <id> may have fixed, each once, the first occurrence winning: [{ fp, own }]. <entries> are
// security.md's, for a `security-<8 hex>` ticket's audit entries.
function securityCandidates(id, entries) {
  const out = []
  const add = (fp, own) => out.some((c) => c.fp === fp) || out.push({ fp, own })
  // Read as 10x-security's ticketNames reads the header lines.
  const file = path.join(tdir(id), 'ticket.md')
  if (fs.lstatSync(tdir(id), { throwIfNoEntry: false })?.isDirectory() && fs.lstatSync(file, { throwIfNoEntry: false })?.isFile())
    for (const l of fs.readFileSync(file, 'utf8').split('\n').slice(1)) {
      if (!/^[A-Za-z]+: /.test(l)) break
      const m = /^Security: (sha256:[0-9a-f]{64})$/.exec(l.trim())
      if (m) add(m[1], true)
    }
  const text = readOr(ROADMAP)
  const p = text === null ? null : roadmap.parse(text, roadmap.ticketTest(TENX_DIR))
  if (p && !p.faults.length)
    for (const row of p.rows)
      for (const it of row.items) {
        const m = it.id === id && / \(security (sha256:[0-9a-f]{64})\)$/.exec(it.text.replace(/\s*`[^`]*`\s*$/, ''))
        if (m) add(m[1], true)
      }
  const a = /^security-([0-9a-f]{8})$/.exec(id)
  if (a) for (const e of entries) if (e.fp.startsWith(`sha256:${a[1]}`) && sec.list(e.values['seen in']).includes(id)) add(e.fp, true)
  const plan = readOr(path.join(tdir(id), 'plan.md'))
  const ac = plan && md.sections(plan).find((s) => s.name.toLowerCase() === 'acceptance criteria')
  if (ac) for (const fp of plan.split('\n').slice(ac.from, ac.to).join('\n').match(FPS) || []) add(fp, false)
  return out
}

// The last `## Round <n> — full|fixes` of ticket <id>'s review.md: { n, security, text }, <security> whether a
// `Reviewers:` line names 10x:security-reviewer, <text> the round without its `Criteria:` line, `### Fixes applied` and
// `### Decisions`; null when there is none, or review.md is missing or not a regular file.
function lastRound(id) {
  const file = path.join(tdir(id), 'review.md')
  if (!fs.lstatSync(file, { throwIfNoEntry: false })?.isFile()) return null
  const lines = fs.readFileSync(file, 'utf8').split('\n')
  let at = -1
  let n = null
  lines.forEach((l, k) => {
    const m = /^## Round ([0-9]+) — (?:full|fixes)[ \t]*$/.exec(l)
    if (m) [at, n] = [k, m[1]]
  })
  if (at < 0) return null
  let end = lines.findIndex((l, k) => k > at && /^#{1,2} /.test(l))
  if (end < 0) end = lines.length
  const body = lines.slice(at + 1, end)
  const security = body.some((l) => /^Reviewers:/.test(l) && l.slice(10).split(',').map((x) => x.trim()).includes('10x:security-reviewer'))
  const kept = []
  let skip = false
  for (const l of body) {
    const h = /^(#{1,3}) +(.*?)\s*$/.exec(l)
    if (h) skip = h[1] === '###' && /^(Fixes applied|Decisions)$/.test(h[2])
    if (!skip && !/^Criteria:/.test(l)) kept.push(l)
  }
  return { n, security, text: kept.join('\n') }
}

// Ticket <id>'s security record as board lines: { section, need }.
function securityLines(id) {
  const text = readOr(path.join(sdir(id), 'security'))
  if (text === null) return { section: [], need: [] }
  if (text.trim() === 'claimed') {
    const l = `- ${id} — security check did not finish; see ${path.join(sdir(id), 'security')}`
    return { section: [l], need: [l] }
  }
  const section = []
  const need = []
  for (const line of text.split('\n').filter(Boolean)) {
    const [what, fp, x = ''] = line.split('\t')
    if (what === 'removed') section.push(`- ${id} — removed ${fp} (review.md round ${x})`)
    else if (what === 'gone') section.push(`- ${id} — ${fp} already gone`)
    else if (what === 'kept') {
      section.push(`- ${id} — kept ${fp}: ${x}`)
      need.push(`- ${id} — security entry kept ${fp}: ${x}`)
    }
  }
  return { section, need }
}

// ---------------------------------------------------------------- board

function board(rows) {
  const cell = (s) => (s ? flat(s).replace(/\|/g, '\\|') : '—')
  const lines = ['# Batch board', '', `mode: ${mode()}`, '', '| # | Ticket | Phase | Session | Outcome | Evidence |', '|---|---|---|---|---|---|']
  rows.forEach((r, i) =>
    lines.push(`| ${i + 1} | ${r.id} | ${r.phase} | ${cell(r.session)} | ${SETTLED.has(r.phase) ? r.phase : '—'} | ${cell(r.evidence)} |`),
  )
  const need = []
  const secLines = []
  for (const r of rows) {
    const s = securityLines(r.id)
    secLines.push(...s.section)
    if (r.phase === 'waiting') need.push(`- ${r.id} — waiting${r.approvable ? ', plan approvable' : ''}: ${r.evidence ? flat(r.evidence) : 'no turn recorded'}`)
    else if (r.phase === 'failed' || r.phase === 'held') need.push(`- ${r.id} — ${r.phase}: ${flat(r.evidence)}`)
    else if (r.phase === 'pr-open') need.push(`- ${r.id} — merge ${flat(r.evidence)}`)
    else if (r.denied) need.push(`- ${r.id} — ${r.phase}: ${flat(r.denied)}`)
    if (r.phase !== 'landed') for (const x of r.relocked) need.push(`- ${r.id} — relocked: ${flat(x)}`)
    if (r.phase !== 'landed') for (const x of r.decided) need.push(`- ${r.id} — decided: ${x}`)
    need.push(...s.need)
  }
  lines.push('', '## Needs the human', ...(need.length ? need : ['- none']))
  const rr = rows.flatMap((r) =>
    reruns(r.id).map((x) => `- ${r.id} — ${flat(x.gate)}: ${flat(x.result)} (run ${pad(x.run)}, ${rel(path.join(WT_DIR, r.id))} at ${x.head === '-' ? '-' : short(x.head)})`),
  )
  if (rr.length) lines.push('', '## Host reruns', ...rr)
  const aside = rows
    .filter((r) => r.setAside)
    .map((r) => `- ${r.id} — ${r.phase}, waiting ${Math.floor(r.waited / 3600000)}h ${pad(Math.floor(r.waited / 60000) % 60)}m: ${r.evidence ? flat(r.evidence) : 'no turn recorded'}`)
  if (aside.length) lines.push('', '## Set aside', ...aside)
  if (secLines.length) lines.push('', '## Security entries', ...secLines)
  // Landed tickets and the ids closed at init, under the first recorded version whose row lists them, then the rest.
  const closed = (readOr(CLOSED) || '').split('\n').map((s) => s.trim()).filter((s) => ID.test(s))
  const pool = [...new Set([...rows.filter((r) => r.phase === 'landed').map((r) => r.id), ...closed])]
  const seen = new Set()
  const hand = []
  const list = (v, id) => {
    if (!pool.includes(id) || seen.has(id)) return
    seen.add(id)
    for (const h of handPending(id)) hand.push(`- ${v} — ${id} ${h.ac}: ${flat(h.text)}`)
  }
  for (const row of versionRows()) for (const id of row.ids) list(row.version, id)
  for (const id of pool) list('(no version)', id)
  if (hand.length) lines.push('', '## Hand checks pending', ...hand)
  return lines.join('\n') + '\n'
}

// The roadmap rows of the recorded versions, in S/batch/versions order; none with no versions file, no roadmap.md, or a
// roadmap that fails its check.
function versionRows() {
  const names = (readOr(VERSIONS) || '').split('\n').map((s) => s.trim()).filter((s) => ID.test(s))
  const text = names.length ? readOr(ROADMAP) : null
  if (text === null) return []
  const p = roadmap.parse(text, roadmap.ticketTest(TENX_DIR))
  if (p.faults.length) return []
  return names.map((v) => p.rows.find((r) => r.version === v)).filter(Boolean)
}

function writeBoard(rows) {
  fs.mkdirSync(BATCH, { recursive: true })
  const text = board(rows)
  put(BOARD, text)
  return text
}

// Not in writeBoard(): background `run`s call that concurrently, and roadmap.md has no lock.
function report(rows) {
  const text = writeBoard(rows)
  const acts = actions(rows)
  const done = markDone(rows)
  const open = undecided(rows).map((id) => `no decisions: ${id}\n`).join('')
  process.stdout.write(text + (acts.length ? '\n' + acts.join('\n') + '\n' : '') + open + done.map((l) => l + '\n').join(''))
}

// The tickets whose product questions were never settled up front, in board order: no decisions section in ticket.md,
// no approved plan and no run yet.
function undecided(rows) {
  return rows
    .filter((r) => !r.last && !md.hasDecisions(readOr(path.join(tdir(r.id), 'ticket.md')) || ''))
    .filter((r) => !/^Status:\s*approved\s*$/m.test(readOr(path.join(tdir(r.id), 'plan.md')) || ''))
    .map((r) => r.id)
}

// Sets `Done <date>` on each recorded version whose ids have all landed or were closed at init and have no hand check
// pending; a version already done, gone from the roadmap, or in a roadmap that fails its check is left as it is.
function markDone(rows) {
  const names = (readOr(VERSIONS) || '').split('\n').map((s) => s.trim()).filter((s) => ID.test(s))
  if (!names.length || fs.lstatSync(ROADMAP, { throwIfNoEntry: false })?.isFile() !== true) return []
  let text = readOr(ROADMAP)
  const p = text === null ? null : roadmap.parse(text, roadmap.ticketTest(TENX_DIR))
  if (!p || p.faults.length) return []
  const landed = new Set([...rows.filter((r) => r.phase === 'landed').map((r) => r.id), ...(readOr(CLOSED) || '').split('\n').map((s) => s.trim())])
  const date = today()
  const out = []
  for (const v of names) {
    const row = p.rows.find((r) => r.version === v)
    if (!row || roadmap.isDone(row.state) || !row.ids.length || !row.ids.every((id) => landed.has(id))) continue
    if (row.ids.some((id) => handPending(id).length)) continue
    text = roadmap.setState(text, v, `Done ${date}`)
    out.push(`roadmap: ${v} Done ${date}`)
  }
  if (out.length) put(ROADMAP, text)
  return out
}

// ---------------------------------------------------------------- commands

function status() {
  report(deriveAll(readIds()))
}

function ticketRows(id) {
  const ids = readIds()
  if (!ids.includes(id)) die(`${id} is not in this batch (${TICKETS})`)
  const rows = deriveAll(ids)
  return { ids, rows, i: ids.indexOf(id) }
}

async function run(argv, replan = false) {
  if (argv.length !== 2 || !KINDS.includes(argv[1])) die(USAGE)
  const [id, kind] = argv
  const { ids, rows, i } = ticketRows(id)
  const r = rows[i]
  if (replan && r.phase !== 'failed') die(`replan ${id} refused: ${id} is ${r.phase}, not failed`)
  if (r.phase === 'dropped') die(`${kind} ${id} refused: ${id} is dropped`)
  if (roadmap.GH.test(id)) {
    const refused = owner(id.slice(3))
    if (refused) die(refused)
  }
  let prompt, flag, session, sessionKind
  const replyFile = path.join(bdir(id), 'reply.md')
  if (kind === 'reply') {
    if (!r.last) die(`reply ${id} refused: ${id} has no session to reply to`)
    if (Object.values(RUNNING).includes(r.phase)) die(`reply ${id} refused: ${id} is ${r.phase}; its run must end first`)
    // The round this ticket's question came from: plan-session runs that started before its latest run ended. Replies of
    // one round run together; `status` holds the next round until they have all ended.
    const ended = Number(r.last.end) || Infinity
    const planning = rows.filter((e) => e.phase === 'planning' && Number(e.last.start) < ended).map((e) => e.id)
    if (r.last.session_kind === 'plan' && planning.length)
      die(`reply ${id} refused: a planning round is answered once every planning run of it has ended (${planning.join(', ')} still planning)`)
    if (fs.lstatSync(replyFile, { throwIfNoEntry: false })?.isFile() !== true) die(`reply ${id} refused: no reply at ${rel(replyFile)}`)
    prompt = fs.readFileSync(replyFile, 'utf8')
    if (!prompt.trim()) die(`reply ${id} refused: ${rel(replyFile)} is empty`)
    // A worker would take it as a typed command, with that skill's grants.
    if (prompt.trimStart().startsWith('/')) die(`reply ${id} refused: ${rel(replyFile)} starts with '/'`)
    if (!UUID.test(r.last.session)) die(`reply ${id} refused: its latest session '${flat(r.last.session)}' is not a session id`)
    ;[flag, session, sessionKind] = ['--resume', r.last.session, r.last.session_kind]
  } else {
    if (!replan && !actions(rows).includes(`${kind} ${id}`)) die(refusal(rows, i, kind))
    prompt = kind === 'close' ? `/10x:close ${id}` : `/10x:work ${id}`
    ;[flag, session, sessionKind] = ['--session-id', randomUUID(), kind]
  }
  // A replanned ticket needs a new approval, whatever its plan.md says.
  if (replan) {
    const plan = path.join(tdir(id), 'plan.md')
    for (const p of [tdir(id), plan]) if (fs.lstatSync(p, { throwIfNoEntry: false })?.isSymbolicLink()) die(`replan ${id} refused: ${rel(p)} is a symlink`)
    for (const p of [approval(id), path.join(sdir(id), 'auto-approved'), replyFile]) fs.rmSync(p, { force: true })
    const text = readOr(plan)
    const draft = text === null ? null : text.replace(/^Status:[ \t]*approved(?=[ \t]*\r?$)/m, 'Status: draft')
    if (draft !== text) put(plan, draft)
  }

  fs.mkdirSync(bdir(id), { recursive: true })
  mkd(sdir(id))
  if (kind === 'implement' && fs.existsSync(path.join(WT_DIR, id, '.git'))) {
    const why = rebaseOntoBase(path.join(WT_DIR, id))
    if (why) {
      // Recorded as a failed implement run, so the ticket is failed (set aside) and `loop` takes the run as started.
      const prev = runs(id)
      const n = String(prev.length + 1)
      const now = String(Date.now())
      put(path.join(bdir(id), `${pad(n)}-rebase`), flat(why) + '\n')
      writeRuns(id, [...prev, { n, kind, session, session_kind: sessionKind, start: now, end: now, exit: '2', pid: '' }])
      writeBoard(deriveAll(ids))
      die(`implement ${id} refused: ${flat(why)}`)
    }
  }
  const turn = path.join(bdir(id), 'turn.md')
  const bin = process.env.TENX_BATCH_CLAUDE || 'claude'
  // Every worker starts in auto mode. A plan session's writes are kept under .10x/<id>/ by hooks/plan-boundary.js, which
  // reads TENX_BATCH_PLAN_DIR; no other worker gets the variable, whatever this process inherited.
  // `claude -p` stops background tasks 10 minutes after the last turn unless CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS is 0,
  // which would kill /10x:work's delegated engineer agents; a value the user set is kept. TENX_BATCH makes this script
  // refuse to let the worker drive the batch.
  const env = { ...process.env, TENX_BATCH: '1', CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS: process.env.CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS ?? '0' }
  delete env.TENX_BATCH_PLAN_DIR
  if (sessionKind === 'plan') env.TENX_BATCH_PLAN_DIR = tdir(id)
  // The commands hooks/grant.js keeps in ALWAYS_ASK — keep the two lists the same. No worker needs them (the conductor
  // posts comments and approves), so every run is denied them rather than left to auto mode's classifier. Each of them
  // also refuses on its own under TENX_BATCH (tests/batch.test.sh checks every one), so a full path or `sh -c` that
  // slips past these rules still fails.
  const denied = [
    '10x-land issue',
    '10x-land comment',
    '10x-land decisions',
    '10x-land advisory',
    '10x-batch approve',
    '10x-batch init',
    '10x-batch accept-green',
    '10x-batch checked',
    '10x-security set',
    '10x-security remove',
    '10x-security ticket',
    '10x-feedback issue',
    '10x-feedback comment',
  ]
    .flatMap((c) => [`Bash(${c}:*)`, `Bash(${c} *)`])
    // The sandbox wraps only Bash: Write and Edit would otherwise reach the records, settings that widen the sandbox,
    // and files a process outside the sandbox runs.
    .concat([`${S}/**`, ...new Set(SETTINGS_FILES.flatMap((f) => [f, real(f)])), ...writeDeny(id).edit].map((p) => `Edit(/${p})`))
  // Bash's side of the same table, with the worktrees registered now.
  const settings = sandbox(id)
  // Today's mode for the session kind, used only when auto mode is unavailable.
  const fallback = sessionKind === 'plan' ? ['default', '--allowedTools', `Edit(.10x/${id}/**)`] : ['acceptEdits']
  const live = { child: null, signalled: false }
  for (const s of ['SIGTERM', 'SIGINT'])
    process.on(s, () => {
      live.signalled = true
      try {
        live.child?.kill(s)
      } catch {}
    })

  // One worker run, recorded in runs.tsv. Its stream-json's init event is read as soon as its line is complete: listing
  // no 10x:work, the plugin is missing and the worker is stopped; started in auto mode and reporting another permission
  // mode, auto mode is unavailable and the worker is stopped.
  // The prompt goes after `--`, so a reply starting with `-` is never an option. A host-rerun reply (<host>) is saved
  // as <nn>-reply.md like any reply, and leaves reply.md alone.
  const once = async (mode, kind, flag, sess, prompt, host = false) => {
    const prev = runs(id)
    const n = prev.length + 1
    const nn = pad(n)
    const log = path.join(bdir(id), `${nn}-${kind}.jsonl`)
    put(turn, '')
    const out = fs.openSync(log, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_TRUNC | fs.constants.O_NOFOLLOW)
    const child = spawn(bin, ['-p', '--output-format', 'stream-json', '--verbose', '--settings', settings, '--plugin-dir', PLUGIN, '--permission-mode', ...mode, '--disallowedTools', ...denied, flag, sess, '--', prompt], {
      cwd: ROOT,
      stdio: ['ignore', out, 'inherit'],
      env,
    })
    live.child = child
    fs.closeSync(out)
    let ended = false
    const exited = new Promise((res) => {
      child.on('error', (e) => {
        process.stderr.write(`10x-batch: cannot start ${bin}: ${e.message}\n`)
        res(null)
      })
      child.on('exit', (code, sig) => res(code ?? 128 + (os.constants.signals[sig] || 0)))
    }).finally(() => (ended = true))
    const row = { n: String(n), kind, session: sess, session_kind: sessionKind, start: String(Date.now()), end: '', exit: '', pid: child.pid ? String(child.pid) : '' }
    writeRuns(id, [...prev, row])
    if (mode[0] !== 'auto') put(path.join(bdir(id), `${nn}-fallback`), mode[0] + '\n')
    // The board shows the running worker and its session for as long as it runs.
    writeBoard(deriveAll(ids))
    if (kind === 'reply' && child.pid) {
      put(path.join(bdir(id), `${nn}-reply.md`), prompt)
      if (!host) fs.rmSync(replyFile, { force: true })
    }
    let init = null
    if (child.pid) {
      while ((init = initEvent(log)) === undefined && !ended) await new Promise((res) => setTimeout(res, 100))
      if (init === undefined) init = initEvent(log) ?? null
    }
    const ev = init && typeof init === 'object' ? init : null
    const missing = !!ev && !(Array.isArray(ev.slash_commands) && ev.slash_commands.includes('10x:work'))
    const unavailable = !missing && mode[0] === 'auto' && typeof ev?.permissionMode === 'string' && ev.permissionMode !== 'auto'
    if (missing || unavailable) {
      try {
        child.kill('SIGTERM')
      } catch {}
    }

    const code = await exited
    const { texts, denials, sandbox } = readLog(log)
    put(turn, texts.length ? texts.join('\n\n') + '\n' : '')
    put(path.join(bdir(id), `${nn}-denials.tsv`), denials.map((d) => d + '\n').join(''))
    if (sandbox) put(path.join(bdir(id), `${nn}-sandbox`), 'unavailable\n')
    if (missing) put(path.join(bdir(id), `${nn}-plugin`), 'missing\n')
    const now = runs(id).map((x) => (x.n === row.n ? { ...x, end: String(Date.now()), exit: String(code ?? 127) } : x))
    writeRuns(id, now)
    // Where it landed, read now: the base moves on as later tickets land.
    if (kind === 'close' && code === 0 && !fs.existsSync(path.join(WT_DIR, id))) put(path.join(bdir(id), `${nn}-landed`), landedOn() + '\n')
    return { code, unavailable }
  }

  const dropped = () => fs.existsSync(path.join(sdir(id), 'dropped'))
  // The turn again in today's mode, unless the ticket was dropped or this process stopped meanwhile. A rerun is checked
  // for the plugin, never for its mode; plan, implement and close start a new session, a reply resumes the same one.
  // A worker whose sandbox is unavailable writes no init event, so it is never rerun.
  const turnOf = async (kind, flag, sess, prompt, host) => {
    const r = await once(['auto'], kind, flag, sess, prompt, host)
    if (!r.unavailable || live.signalled || dropped()) return r
    return once(fallback, kind, flag, kind === 'reply' ? sess : randomUUID(), prompt, host)
  }
  let res = await turnOf(kind, flag, session, prompt, false)
  // The gates an implement or close session reported sandbox-red, rerun on the host; all green, the session is resumed
  // with their output and its next report handled the same way.
  while (HOST_RERUN && res.code === 0 && ['implement', 'close'].includes(sessionKind) && !live.signalled && !dropped()) {
    const reply = await rerunGates(id, live, dropped)
    if (!reply || live.signalled || dropped()) break
    res = await turnOf('reply', '--resume', runs(id).at(-1).session, reply, true)
  }
  const after = deriveAll(ids)
  settleSecurity(after)
  writeBoard(after)
  if (res.code === null) process.exit(2)
  process.stdout.write(`phase: ${after[i].phase}\nboard: ${BOARD}\n`)
  process.exit(0)
}

// Handles the sandbox-red gates ticket <id>'s latest run reported, in report order, recording each in reruns.tsv; returns
// the reply to resume the session with when at least one gate ran and every one is green, else null. A gate runs
// outside the sandbox, in the worktree, only when it is an entry of the main checkout's `gates` and worktree.pin passes;
// one already recorded green or red at this HEAD is not run again. S/batch/<id>/rerun holds this pid meanwhile.
async function rerunGates(id, live, dropped) {
  const n = runs(id).at(-1).n
  const asks = sandboxAsks(id)
  if (!asks.length) return null
  const wt = path.join(WT_DIR, id)
  const file = path.join(sdir(id), 'reruns.tsv')
  const marker = path.join(sdir(id), 'rerun')
  const clear = () => fs.rmSync(marker, { force: true })
  const record = (x) =>
    put(file, [RERUN_HEADER, ...[...reruns(id), x].map((r) => RERUN_HEADER.map((h) => r[h]))].map((c) => c.join('\t') + '\n').join(''))
  put(marker, `${process.pid}\n`)
  process.once('exit', clear)
  let k = reruns(id).filter((x) => x.run === n && x.log).length
  const done = []
  try {
    for (const gate of asks) {
      if (dropped() || live.signalled) return null
      const g =gate.replace(/[\t\n]/g, ' ')
      const pin = worktree.pin(wt, common)
      if (pin.reason) {
        const x = { run: n, gate: g, head: '-', result: `refused: ${flat(pin.reason)}`, exit: '', log: '' }
        record(x)
        done.push(x)
        continue
      }
      // Read as accept-green reads it: only the worktree's HEAD file pinned, a branch's commit in the main checkout.
      const wtGit = (a) => git(['-C', wt, ...a], pin.env)
      const ref = wtGit(['symbolic-ref', '-q', 'HEAD'])
      const head = (ref ? git(['rev-parse', '--verify', '-q', `${ref}^{commit}`]) : wtGit(['rev-parse', '--verify', '-q', 'HEAD^{commit}'])) || '-'
      const refuse = head === '-' ? 'no commit at HEAD' : !GATES.includes(gate) ? "not in the main checkout's gates" : null
      if (refuse) {
        const x = { run: n, gate: g, head, result: `refused: ${refuse}`, exit: '', log: '' }
        record(x)
        done.push(x)
        continue
      }
      const prior = reruns(id).find((x) => x.gate === g && x.head === head && ['green', 'red'].includes(x.result))
      if (prior) {
        done.push({ ...prior, prior: true })
        continue
      }
      writeBoard(deriveAll(readIds()))
      const log = `${pad(n)}-rerun-${++k}.log`
      const fd = fs.openSync(path.join(bdir(id), log), fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_TRUNC | fs.constants.O_NOFOLLOW)
      const env = { ...process.env }
      delete env.TENX_BATCH_PLAN_DIR
      const child = spawn('bash', ['-c', gate], { cwd: wt, stdio: ['ignore', fd, fd], env })
      fs.closeSync(fd)
      live.child = child
      const code = await new Promise((res) => {
        child.on('error', () => res(127))
        child.on('exit', (c, sig) => res(c ?? 128 + (os.constants.signals[sig] || 0)))
      })
      live.child = null
      const x = { run: n, gate: g, head, result: code === 0 ? 'green' : 'red', exit: String(code), log }
      record(x)
      done.push(x)
    }
  } finally {
    clear()
    process.removeListener('exit', clear)
  }
  if (done.some((x) => x.result !== 'green') || done.every((x) => x.prior)) return null
  const out = done.map((x) => {
    const lines = tail(x.log, 40, id)
    const run = Math.max(2, ...lines.map((l) => l.match(/`+/g)?.reduce((a, b) => Math.max(a, b.length), 0) || 0)) + 1
    const fence = '`'.repeat(run)
    return `\`${x.gate}\` in ${rel(wt)} at ${short(x.head)}: green (exit 0). Last 40 lines of its output:\n\n${fence}\n${lines.join('\n')}\n${fence}\n`
  })
  return [
    'Host rerun by the conductor, outside the sandbox.\n',
    ...out,
    'Remove each `- asked: sandbox-red:` line it answers, use this as that gate\'s evidence, and go on. A 10x-verify FAIL of these gates at this commit is not a failure.\n',
  ].join('\n')
}

// Moves worktree <wt>'s branch onto the current base, fetched first when origin exists; null when it is there, else why
// not, the branch left as it was. git runs pinned, as in accept-green: config and hooks come from the common dir.
function rebaseOntoBase(wt) {
  const pin = worktree.pin(wt, common)
  if (pin.reason) return pin.reason
  const b = baseBranch()
  if (git(['remote', 'get-url', 'origin']) !== null && git(['fetch', '--quiet', 'origin', `+refs/heads/${b}:refs/remotes/origin/${b}`]) === null)
    return `could not fetch origin/${b}`
  const ref = baseRef()
  const sha = git(['rev-parse', '--verify', '-q', `${ref}^{commit}`])
  if (!sha) return `no commit for ${ref}`
  const wtGit = (a) => git(['-C', wt, ...a], pin.env)
  const gitDir = wtGit(['rev-parse', '--git-dir'])
  if (gitDir === null) return `rebase onto ${ref} failed`
  const inProgress = () => ['rebase-merge', 'rebase-apply'].some((d) => fs.existsSync(path.resolve(wt, gitDir, d)))
  if (inProgress()) return `a rebase is already in progress in ${wt}`
  const dirty = wtGit(['diff', '--name-only', 'HEAD'])
  if (dirty === null) return `rebase onto ${ref} failed`
  if (dirty) return `uncommitted changes in ${wt}: ${dirty.split('\n').join(', ')}`
  if (wtGit(['merge-base', '--is-ancestor', sha, 'HEAD']) !== null) return null
  if (wtGit(['rebase', sha]) !== null) return null
  const unmerged = wtGit(['diff', '--name-only', '--diff-filter=U']) || ''
  if (inProgress()) wtGit(['rebase', '--abort'])
  return unmerged ? `rebase onto ${ref} conflicts in ${unmerged.split('\n').join(', ')}` : `rebase onto ${ref} failed`
}

// A stream-json log's init event, read from its complete lines: other system events (SessionStart hooks) may come
// first. undefined while no init line is there yet; null when an event that is not a system one comes first (init
// precedes every turn).
function initEvent(file) {
  const text = readOr(file) || ''
  for (const l of text.slice(0, text.lastIndexOf('\n') + 1).split('\n')) {
    if (!l.trim()) continue
    let ev
    try {
      ev = JSON.parse(l)
    } catch {
      continue
    }
    if (!ev || ev.type !== 'system') return null
    if (ev.subtype === 'init') return ev
  }
  return undefined
}

// Every top-level assistant text block of a stream-json log, in order, its permission denials, and whether Claude Code
// refused to start without its sandbox.
function readLog(file) {
  const texts = []
  const denied = new Map()
  let sandbox = false
  for (const l of (readOr(file) || '').split('\n')) {
    if (!l.trim()) continue
    let ev
    try {
      ev = JSON.parse(l)
    } catch {
      continue
    }
    if (ev.type === 'assistant' && ev.parent_tool_use_id == null && Array.isArray(ev.message?.content)) {
      for (const c of ev.message.content) if (c.type === 'text' && typeof c.text === 'string' && c.text.trim()) texts.push(c.text.trim())
    } else if (ev.type === 'result') {
      for (const d of ev.permission_denials || []) denied.set(d.tool_use_id, d)
      if (ev.startup_failure_reason === 'sandbox_required_unavailable') sandbox = true
    }
  }
  const denials = [...denied.values()].map((d) => {
    const tool = flat(d.tool_name || 'unknown')
    return `${tool}\t${flat((d.tool_input && (d.tool_input.command || d.tool_input.file_path)) || tool)}`
  })
  return { texts, denials, sandbox }
}

function drop(argv) {
  if (argv.length !== 1) die(USAGE)
  const [id] = argv
  const { ids } = ticketRows(id)
  mkd(sdir(id))
  put(path.join(sdir(id), 'dropped'), `${new Date().toISOString()}\n`)
  const last = runs(id).at(-1)
  if (last && isOpen(last) && ours(last)) {
    try {
      process.kill(Number(last.pid), 'SIGTERM')
    } catch {}
  }
  // A host rerun in progress: its `10x-batch run <id>` forwards SIGTERM to the gate and ends its loop.
  const rerun = (readOr(path.join(sdir(id), 'rerun')) || '').trim()
  if (alive(rerun)) {
    const ps = spawnSync('ps', ['-o', 'command=', '-p', String(Number(rerun))], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
    const args = ps.status === 0 ? ps.stdout.trim().split(/\s+/) : []
    if (args.some((a, k) => a === 'run' && args[k + 1] === id && /10x-batch$/.test(args[k - 1] || ''))) {
      try {
        process.kill(Number(rerun), 'SIGTERM')
      } catch {}
    }
  }
  writeBoard(deriveAll(ids))
  process.stdout.write(`dropped: ${id}\nboard: ${BOARD}\n`)
}

// All or nothing: every id is checked before any record or reply is written.
function approve(argv) {
  if (!argv.length) die(USAGE)
  const want = [...new Set(argv)]
  const ids = readIds()
  const rows = deriveAll(ids)
  const errors = []
  for (const id of want) {
    if (!ids.includes(id)) {
      errors.push(`${id} is not in this batch (${TICKETS})`)
      continue
    }
    const r = rows[ids.indexOf(id)]
    if (r.phase !== 'waiting' || !r.approvable) errors.push(`approve ${id} refused: ${id} is ${r.phase}${r.phase === 'waiting' ? ' and its plan.md is not a draft that passes 10x-plan-check' : ''}`)
  }
  if (errors.length) {
    for (const e of errors) process.stderr.write(`10x-batch: ${e}\n`)
    process.exit(2)
  }
  for (const id of want) {
    const hash = recordApproval(id)
    process.stdout.write(`approved: ${id}\nplan: ${rel(path.join(tdir(id), 'plan.md'))} sha256 ${hash.slice(0, 12)}\nreply: ${rel(path.join(bdir(id), 'reply.md'))}\n`)
  }
}

// The approval record of ticket <id>'s plan.md and the approve reply; returns the hash.
function recordApproval(id) {
  mkd(S)
  const hash = planHash(fs.readFileSync(path.join(tdir(id), 'plan.md'), 'utf8'))
  put(approval(id), hash + '\n')
  fs.mkdirSync(bdir(id), { recursive: true })
  put(path.join(bdir(id), 'reply.md'), APPROVE_REPLY)
  return hash
}

// The user's acceptance of a test file that stays GREEN in red-proof: an entry of S/batch/<id>/accepted-green.md, which
// red-proof and the review packet read for a batch ticket instead of .10x/<id>/accepted-green.md.
function acceptGreen(argv) {
  if (argv.length !== 3) die(USAGE)
  const [id, arg] = argv
  if (!readIds().includes(id)) die(`${id} is not in this batch (${TICKETS})`)
  if (fs.existsSync(path.join(sdir(id), 'dropped'))) die(`accept-green ${id} refused: ${id} is dropped`)
  const reason = flat(argv[2]).trim()
  if (!reason) die(`accept-green ${id} refused: the reason is empty`)
  const file = arg.replace(/^\.\//, '')
  if (!file || /[\x00-\x1f\x7f]/.test(file) || path.isAbsolute(file) || file.split('/').includes('..'))
    die(`accept-green ${id} refused: '${flat(arg)}' is not a path relative to the worktree root`)
  const wt = path.join(WT_DIR, id)
  if (!fs.existsSync(path.join(wt, '.git'))) die(`accept-green ${id} refused: ${id} has no worktree at ${wt}`)
  const pin = worktree.pin(wt, common)
  if (pin.reason) die(`accept-green ${id} refused: ${pin.reason}`)
  // Pinned git still resolves refs through the admin dir's commondir, which a worker can rewrite: only the worktree's
  // own HEAD file is read pinned, and the commits are read in the main checkout.
  const wtGit = (a) => git(['-C', wt, ...a], pin.env)
  const head = wtGit(['symbolic-ref', '-q', 'HEAD'])
  const tip = head ? git(['rev-parse', '--verify', '-q', `${head}^{commit}`]) : wtGit(['rev-parse', '--verify', '-q', 'HEAD^{commit}'])
  if (!tip) die(`accept-green ${id} refused: no commit at HEAD`)
  const ref = baseRef()
  const mb = git(['merge-base', ref, tip])
  if (!mb) die(`accept-green ${id} refused: no merge base with ${ref}`)
  // The test files red-proof runs: redProof.tests when redProof.command is set (the worktree's config, else the main
  // checkout's), else its JavaScript test-file pattern.
  const cfgFile = [path.join(wt, '.claude', '10x.json'), path.join(ROOT, '.claude', '10x.json')].find((f) => fs.existsSync(f))
  let rp
  try {
    rp = cfgFile ? JSON.parse(fs.readFileSync(cfgFile, 'utf8'))?.redProof : undefined
  } catch (e) {
    die(`cannot read ${cfgFile}: ${e.message}`)
  }
  const cmd = rp?.command == null ? '' : String(rp.command)
  const globs = cmd ? (Array.isArray(rp.tests) ? rp.tests : rp.tests == null ? [] : [rp.tests]).map(String).filter(Boolean) : []
  if (cmd && !globs.length) die('redProof.command is set but redProof.tests is missing (git pathspec globs naming the test files)')
  const out = git(['diff', '-z', '--name-only', '--no-renames', '--diff-filter=AMT', mb, tip, ...(cmd ? ['--', ...globs.map((g) => `:(glob)${g}`)] : [])])
  if (out === null) die(`accept-green ${id} refused: cannot list the files the branch changes`)
  const tests = out.split('\0').filter((f) => f && (cmd || /\.(test|spec)\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$/.test(f)))
  if (!tests.includes(file)) die(`accept-green ${id} refused: ${flat(file)} is not a test file the branch adds or modifies`)
  const blob = git(['rev-parse', `${tip}:${file}`])
  if (!blob) die(`accept-green ${id} refused: no blob for ${flat(file)} at HEAD`)
  mkd(sdir(id))
  const rec = path.join(sdir(id), 'accepted-green.md')
  const old = (readOr(rec) || '').trimEnd()
  const entry = `## Accepted ${(old.match(/^## Accepted/gm) || []).length + 1}\n- file: ${file}\n- blob: ${blob}\n- reason: ${reason}\n`
  put(rec, old ? `${old}\n\n${entry}` : entry)
  process.stdout.write(`accepted: ${id} ${file} blob ${blob.slice(0, 12)}\n`)
}

// The user's word that a pending hand check passed: a `met:` line appended to .10x/<id>/evidence.md, where every other
// state of the criterion is.
function checked(argv) {
  if (argv.length !== 3) die(USAGE)
  const [id, arg] = argv
  if (!ID.test(id)) die(`checked ${flat(id)} refused: not a ticket id`)
  const m = /^AC(\d+)$/.exec(arg)
  if (!m) die(`checked ${id} refused: '${flat(arg)}' is not a criterion (AC<n>)`)
  const ac = `AC${Number(m[1])}`
  const words = flat(argv[2]).trim()
  if (!words) die(`checked ${id} refused: the words are empty`)
  const plan = path.join(tdir(id), 'plan.md')
  const ev = path.join(tdir(id), 'evidence.md')
  for (const p of [tdir(id), plan, ev]) {
    const st = fs.lstatSync(p, { throwIfNoEntry: false })
    if (!st) die(`checked ${id} refused: no ${rel(p)}`)
    if (st.isSymbolicLink()) die(`checked ${id} refused: ${rel(p)} is a symlink`)
  }
  if (!md.handChecks(fs.readFileSync(plan, 'utf8')).includes(ac)) die(`checked ${id} refused: the plan does not declare ${ac} a hand check`)
  const v = evidenceLines(id).state.get(ac)
  if (v === undefined || !/^hand-check:\s*\S/.test(v)) die(`checked ${id} refused: ${ac} is ${v === undefined ? 'not in evidence.md' : `'${flat(v)}'`}, not a pending hand-check`)
  const old = fs.readFileSync(ev, 'utf8')
  put(ev, `${old}${old && !old.endsWith('\n') ? '\n' : ''}- ${ac} — met: hand check by the user on ${today()}: ${words}\n`)
  process.stdout.write(`checked: ${id} ${ac}\n`)
}

// ---------------------------------------------------------------- loop

// A planning question held for the human: any ticket's security or cost question (held-questions.md), and a security
// ticket's product question (its comment for the issue, or its list of product questions). Any other product question
// is answered by the worker under auto mode's fixed reply.
const SECURITY_ID = /^security-[0-9a-f]{8}$/
const heldBack = (id) =>
  fs.existsSync(path.join(tdir(id), 'held-questions.md')) ||
  (SECURITY_ID.test(id) && (fs.existsSync(path.join(tdir(id), 'comment.md')) || fs.existsSync(path.join(tdir(id), 'product-questions.md'))))

const fixedReply = (id) => (SECURITY_ID.test(id) ? SECURITY_FIXED_REPLY : FIXED_REPLY)

// The number of earlier replies to ticket <id> equal to <text>.
const sent = (id, text) => {
  let names = []
  try {
    names = fs.readdirSync(bdir(id))
  } catch {}
  return names.filter((f) => /^[0-9]+-reply\.md$/.test(f) && readOr(path.join(bdir(id), f)) === text).length
}
const fixedSent = (id) => sent(id, fixedReply(id))

// An asked text a batch worker marked as the human's; a sandbox-red ask is the human's too.
const MARKED = /^(\((security|cost|product|human)\)|sandbox-red:)/

async function loop(argv) {
  if (argv.length) die(USAGE)
  const ids = readIds()
  const auto = mode() === 'auto'
  const own = new Map()
  const refused = new Map()
  const held = new Set()
  let woke = false
  let wake = null
  const sleep = (ms) => new Promise((res) => setTimeout(res, ms))
  const ownOpen = () => [...own.values()].some((c) => !c.exited)

  // A detached `run`, so stopping this process leaves it running. It returns once the run's row is recorded or the
  // run has ended, so the next pass derives it; false when it was refused before recording one.
  const start = async (id, kind) => {
    fs.mkdirSync(bdir(id), { recursive: true })
    const errFile = path.join(bdir(id), 'run.err')
    const before = runs(id).length
    const fd = fs.openSync(errFile, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_TRUNC | fs.constants.O_NOFOLLOW)
    const env = { ...process.env }
    delete env.TENX_BATCH
    const c = { exited: false, code: null, ran: false }
    const child = spawn(process.execPath, [__filename, 'run', id, kind], { cwd: ROOT, detached: true, stdio: ['ignore', 'ignore', fd], env })
    fs.closeSync(fd)
    // Only the end of a run that started wakes the loop: a refused one is retried at the next wake, not at once.
    const done = (code) => {
      if (c.exited) return
      Object.assign(c, { exited: true, code })
      if (!c.ran) return
      woke = true
      wake?.()
    }
    child.on('error', () => done(null))
    child.on('exit', (code) => done(code))
    own.set(id, c)
    while (!c.exited && runs(id).length === before) await sleep(50)
    if (!(c.exited && c.code === 2 && runs(id).length === before)) {
      c.ran = true
      if (c.exited) woke = true
      return true
    }
    const line = (readOr(errFile) || '').split('\n').filter((l) => l.startsWith('10x-batch: ')).pop()
    if (line && /^10x-batch: (not your issue|cannot check the author|PATH entry |PNPM_HOME )/.test(line)) refused.set(id, line)
    return false
  }

  for (;;) {
    woke = false
    const rows = deriveAll(ids)
    settleSecurity(rows)
    writeBoard(rows)
    let started = false
    for (const a of actions(rows)) {
      const m = /^(plan|implement|close|answer) (\S+)( approvable)?$/.exec(a)
      if (!m) continue
      const [, kind, id] = m
      if (own.get(id)?.exited === false || refused.has(id)) continue
      if (kind !== 'answer') {
        started = (await start(id, kind)) || started
        continue
      }
      const r = rows.find((e) => e.id === id)
      const replyFile = path.join(bdir(id), 'reply.md')
      if (!fs.existsSync(replyFile) && auto && r.last.session_kind === 'implement' && sent(id, PROCEED_REPLY) < FIXED_MAX) {
        const asks = evidence(id, readOr(path.join(tdir(id), 'plan.md'))).asks
        if (asks.length && !asks.some((a) => MARKED.test(a))) put(replyFile, PROCEED_REPLY)
      }
      if (!fs.existsSync(replyFile) && auto && r.last.session_kind === 'plan' && !heldBack(id) && !held.has(id)) {
        if (r.approvable) {
          if (SECURITY_ID.test(id) || (roadmap.GH.test(id) && strangerComments(id.slice(3)))) held.add(id)
          else {
            const hash = recordApproval(id)
            mkd(sdir(id))
            put(path.join(sdir(id), 'auto-approved'), hash + '\n')
          }
        } else if (fixedSent(id) < FIXED_MAX) put(replyFile, fixedReply(id))
      }
      if (fs.existsSync(replyFile)) started = (await start(id, 'reply')) || started
    }
    const now = started ? null : deriveAll(ids)
    if (now && !ownOpen() && !now.some((r) => Object.values(RUNNING).includes(r.phase))) {
      settleSecurity(now)
      writeBoard(now)
      markDone(now)
      process.stdout.write(JSON.stringify({ items: items(now, auto, refused, held) }) + '\n')
      process.exit(0)
    }
    if (!woke) {
      await new Promise((res) => {
        wake = res
        setTimeout(res, POLL_MS)
      })
      wake = null
    }
  }
}

// What the human is needed for, in board order, at most one item per ticket.
function items(rows, auto, refused, held) {
  const out = []
  for (const r of rows) {
    const item = (need, evidence) => out.push({ id: r.id, need, evidence })
    if (refused.has(r.id)) item('failed', refused.get(r.id))
    else if (r.phase === 'failed') item('failed', r.evidence)
    else if (r.phase === 'waiting') item(r.approvable && (!auto || heldBack(r.id) || held.has(r.id)) ? 'approve' : 'answer', r.evidence)
  }
  if (out.length) return out
  return rows.every((r) => SETTLED.has(r.phase)) ? [{ need: 'done' }] : []
}

const [cmd, ...args] = process.argv.slice(2)
if (cmd === 'init') init(args)
else if (cmd === 'run') run(args)
else if (cmd === 'status' && !args.length) status()
else if (cmd === 'drop') drop(args)
else if (cmd === 'replan') args.length === 1 ? run([args[0], 'plan'], true) : die(USAGE)
else if (cmd === 'approve') approve(args)
else if (cmd === 'accept-green') acceptGreen(args)
else if (cmd === 'checked') checked(args)
else if (cmd === 'loop') loop(args)
else die(USAGE)
